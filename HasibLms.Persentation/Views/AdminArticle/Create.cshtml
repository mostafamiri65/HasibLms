<!-- Views/AdminArticle/Create.cshtml -->
@model HasibLms.Shared.DTOs.Admin.CreateArticleAdminDto
@{
    ViewBag.Title = "ایجاد مقاله جدید";
    Layout = "_AdminLayout";
    var tags = ViewBag.Tags as List<HasibLms.Shared.DTOs.Admin.TagListDto> ?? new();
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">ایجاد مقاله جدید</h1>
            <p class="text-gray-500 dark:text-gray-400">ایجاد مقاله جدید برای سایت</p>
        </div>
        <a href="/admin/articles" class="px-4 py-2 border rounded-lg hover:bg-gray-50">
            <i class="fas fa-arrow-right ml-2"></i>بازگشت
        </a>
    </div>

    <form method="post" enctype="multipart/form-data" id="articleForm">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
                    <h2 class="text-lg font-bold text-gray-800 dark:text-white mb-4">اطلاعات مقاله</h2>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">عنوان مقاله <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Title"
                                   class="w-full px-4 py-2 border rounded-lg @(ViewData.ModelState["Title"]?.Errors.Any() == true ? "border-red-500" : "")"
                                   placeholder="عنوان مقاله را وارد کنید">
                            <span asp-validation-for="Title" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">خلاصه مقاله</label>
                            <textarea asp-for="Summary" rows="3" class="w-full px-4 py-2 border rounded-lg"
                                      placeholder="خلاصه مقاله (حداکثر 500 کاراکتر)"></textarea>
                            <span asp-validation-for="Summary" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">متن مقاله <span class="text-red-500">*</span></label>
                            <!-- ویرایشگر CKEditor اینجا قرار می‌گیرد -->
                            <textarea asp-for="Content" id="contentEditor" name="Content" class="w-full"></textarea>
                            <input type="hidden" asp-for="Content" id="contentHidden" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Publish Settings -->
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
                    <h2 class="text-lg font-bold text-gray-800 dark:text-white mb-4">تنظیمات انتشار</h2>

                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <div>
                                <label class="text-sm font-medium">وضعیت انتشار</label>
                                <p class="text-xs text-gray-500">@(Model?.IsPublished == true ? "منتشر شده" : "پیش‌نویس")</p>
                            </div>
                            <select asp-for="IsPublished" class="px-3 py-1.5 border rounded-lg bg-white dark:bg-gray-800 text-sm">
                                <option value="true">منتشر</option>
                                <option value="false">پیش‌نویس</option>
                            </select>
                        </div>

                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                            <div>
                                <label class="text-sm font-medium">مقاله منتخب</label>
                                <p class="text-xs text-gray-500">نمایش در بخش مقالات منتخب</p>
                            </div>
                            <select asp-for="IsFeatured" class="px-3 py-1.5 border rounded-lg bg-white dark:bg-gray-800 text-sm">
                                <option value="true">بله</option>
                                <option value="false">خیر</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">تگ‌ها</label>
                            <div class="flex flex-wrap gap-2 p-2 border rounded-lg min-h-[40px]" id="tagsContainer">
                                @foreach (var tag in tags)
                                {
                                    <span class="tag-item inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm cursor-pointer hover:bg-blue-200"
                                          data-tag="@tag.Name">
                                        @tag.Name
                                        <i class="fas fa-times text-xs hover:text-red-500" onclick="removeTag(this)"></i>
                                    </span>
                                }
                            </div>
                            <div class="flex gap-2 mt-2">
                                <input type="text" id="tagInput" placeholder="نام تگ جدید..."
                                       class="flex-1 px-3 py-1 border rounded-lg text-sm">
                                <button type="button" onclick="addTag()"
                                        class="px-3 py-1 bg-primary-600 text-white rounded-lg text-sm hover:bg-primary-700">
                                    افزودن
                                </button>
                            </div>
                            <input type="hidden" asp-for="TagNames" id="tagNamesInput">
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3">
                    <button type="submit" class="flex-1 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">
                        <i class="fas fa-save ml-2"></i>ذخیره مقاله
                    </button>
                    <a href="/admin/articles" class="px-4 py-2 border rounded-lg hover:bg-gray-50">انصراف</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof CKEDITOR === 'undefined') {
                console.error('CKEDITOR is not defined');
                Swal.fire({ title: 'خطا', text: 'ویرایشگر بارگذاری نشد', icon: 'error' });
                return;
            }

            const editor = CKEDITOR.replace('contentEditor', {
                language: 'fa',
                height: 500,
                resize_enabled: true,
                contentsLangDirection: 'rtl',
                // ❌ هیچ extraPlugins نگذارید
                filebrowserUploadUrl: '/admin/articles/upload-image',
                filebrowserImageUploadUrl: '/admin/articles/upload-image',
                toolbar: [
                    { name: 'document', items: ['Source', '-', 'Preview', 'Print'] },
                    { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                    { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                    '/',
                    { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                    { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock', '-', 'BidiLtr', 'BidiRtl'] },
                    { name: 'links', items: ['Link', 'Unlink', 'Anchor'] },
                    { name: 'insert', items: ['Image', 'Table', 'HorizontalRule', 'Smiley', 'SpecialChar', 'PageBreak'] },
                    '/',
                    { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                    { name: 'colors', items: ['TextColor', 'BGColor'] },
                    { name: 'tools', items: ['Maximize', 'ShowBlocks'] }
                ],
                on: {
                    instanceReady: function (ev) {
                        console.log('CKEditor 4 ready');
                        const hiddenInput = document.getElementById('contentHidden');
                        if (hiddenInput && hiddenInput.value) {
                            ev.editor.setData(hiddenInput.value);
                        }
                    }
                }
            });

            document.getElementById('articleForm').addEventListener('submit', function () {
                document.getElementById('contentHidden').value = editor.getData();
            });
        });

        // ============================================
        // مدیریت تگ‌ها
        // ============================================
        let selectedTags = new Set();

        function updateTagNamesInput() {
            document.getElementById('tagNamesInput').value = Array.from(selectedTags).join(',');
        }

        function addTag() {
            const input = document.getElementById('tagInput');
            const tagName = input.value.trim();
            if (!tagName) return;

            if (selectedTags.has(tagName)) {
                Swal.fire({ title: 'تکرار', text: 'این تگ قبلاً اضافه شده است', icon: 'warning', confirmButtonText: 'باشه' });
                return;
            }

            selectedTags.add(tagName);
            createTagElement(tagName);
            input.value = '';
            updateTagNamesInput();
        }

        function createTagElement(tagName) {
            const container = document.getElementById('tagsContainer');
            const tagEl = document.createElement('span');
            tagEl.className = 'tag-item inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm';
            tagEl.dataset.tag = tagName;
            tagEl.innerHTML = `${tagName} <i class="fas fa-times text-xs hover:text-red-500 cursor-pointer" onclick="removeTag(this)"></i>`;
            container.appendChild(tagEl);
        }

        function removeTag(element) {
            const tagItem = element.closest('.tag-item');
            const tagName = tagItem.dataset.tag;
            selectedTags.delete(tagName);
            tagItem.remove();
            updateTagNamesInput();
        }

        document.getElementById('tagInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addTag();
            }
        });

        // بارگذاری تگ‌های موجود
        function loadExistingTags() {
            const container = document.getElementById('tagsContainer');
            const existingTags = container.querySelectorAll('.tag-item');
            existingTags.forEach(el => {
                selectedTags.add(el.dataset.tag);
            });
            updateTagNamesInput();
        }

        loadExistingTags();
    </script>
}