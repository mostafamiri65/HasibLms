@model HasibLms.Shared.DTOs.Settings.CreateWhyChooseUsItemDto
@{
    ViewBag.Title = "ایجاد آیتم جدید";
    Layout = "_AdminLayout";
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">@ViewBag.Title</h1>
        <p class="text-gray-500 dark:text-gray-400">ایجاد آیتم جدید برای بخش 'چرا باید ما را انتخاب کنید؟'</p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
        <form method="post" action="/admin/why-choose-us/create">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">عنوان <span class="text-red-500">*</span></label>
                    <input type="text" name="Title" value="@Model.Title" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-800 dark:text-white" required maxlength="200" />
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">توضیحات <span class="text-red-500">*</span></label>
                    <textarea name="Description" rows="3" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-800 dark:text-white" required maxlength="500">@Model.Description</textarea>
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">آیکون (FontAwesome)</label>
                    <input type="text" name="Icon" value="@Model.Icon" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-800 dark:text-white" placeholder="fas fa-star" />
                    <p class="text-xs text-gray-400 mt-1">کلاس آیکون FontAwesome</p>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">رنگ آیکون</label>
                    <input type="color" name="IconColor" value="@(Model.IconColor ?? "#3b82f6")" class="w-full h-12 border border-gray-300 dark:border-gray-600 rounded-lg cursor-pointer" />
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">رنگ پس‌زمینه</label>
                    <input type="color" name="BackgroundColor" value="@(Model.BackgroundColor ?? "#ffffff")" class="w-full h-12 border border-gray-300 dark:border-gray-600 rounded-lg cursor-pointer" />
                    <p class="text-xs text-gray-400 mt-1">برای تغییر رنگ کارت</p>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">وضعیت</label>
                    <select name="IsActive" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-800 dark:text-white">
                        <option value="true" selected="@Model.IsActive">فعال</option>
                        <option value="false" selected="@(!Model.IsActive)">غیرفعال</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">نمایش در صفحه اصلی</label>
                    <select name="ShowOnHomePage" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-800 dark:text-white">
                        <option value="true" selected="@Model.ShowOnHomePage">نمایش</option>
                        <option value="false" selected="@(!Model.ShowOnHomePage)">مخفی</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="/admin/why-choose-us" class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                    انصراف
                </a>
                <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-all">
                    <i class="fas fa-save ml-2"></i>ذخیره
                </button>
            </div>
        </form>
    </div>
</div>