@model HasibLms.Shared.DTOs.PagedResultDto<HasibLms.Shared.DTOs.Admin.ReviewListAdminDto>
@{
    ViewBag.Title = "مدیریت نظرات";
    Layout = "_AdminLayout";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">مدیریت نظرات</h1>
            <p class="text-gray-500 dark:text-gray-400">مدیریت و تأیید نظرات کاربران</p>
        </div>
        <div class="flex gap-2">
            <a href="/admin/reviews?pending=true" class="px-3 py-2 bg-yellow-100 text-yellow-700 rounded-lg hover:bg-yellow-200 @(ViewBag.ShowPendingOnly == true ? "ring-2 ring-yellow-500" : "")">
                <i class="fas fa-clock ml-1"></i>در انتظار تأیید
            </a>
            <a href="/admin/reviews" class="px-3 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 @(ViewBag.ShowPendingOnly != true ? "ring-2 ring-primary-500" : "")">
                <i class="fas fa-list ml-1"></i>همه نظرات
            </a>
        </div>
    </div>

    <div class="space-y-4">
        @foreach (var review in Model.Items)
        {
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
                <div class="flex flex-wrap justify-between items-start gap-4">
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center">
                                <span class="text-white font-medium">@(review.StudentName?.Substring(0, 1) ?? "ک")</span>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800 dark:text-white">@review.StudentName</p>
                                <p class="text-sm text-gray-500">دوره: @review.CourseTitle</p>
                            </div>
                        </div>
                        <div class="flex text-yellow-400 mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas @(i <= review.Rating ? "fa-star" : "fa-star-o")"></i>
                            }
                        </div>
                        <p class="text-gray-600 dark:text-gray-300">@review.Comment</p>
                        <p class="text-xs text-gray-400 mt-2">@review.CreatedAt.ToString("yyyy/MM/dd - HH:mm")</p>
                    </div>
                    <div class="flex gap-2">
                        @if (!review.IsApproved)
                        {
                            <button onclick="approveReview('@review.Id')" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">
                                <i class="fas fa-check ml-1"></i>تأیید
                            </button>
                        }
                        <button onclick="deleteReview('@review.Id')" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">
                            <i class="fas fa-trash ml-1"></i>حذف
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl">
                <i class="fas fa-comment-dots text-6xl text-gray-300 mb-4"></i>
                <p class="text-gray-500">هیچ نظری یافت نشد</p>
            </div>
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex justify-center gap-2 mt-6">
                <a href="?page=@(Model.PageNumber - 1)&pending=@ViewBag.ShowPendingOnly" class="px-3 py-2 rounded-lg border @(Model.HasPreviousPage ? "hover:bg-gray-50" : "opacity-50 pointer-events-none")">قبلی</a>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="?page=@i&pending=@ViewBag.ShowPendingOnly" class="px-3 py-2 rounded-lg border @(i == Model.PageNumber ? "bg-primary-600 text-white" : "hover:bg-gray-50")">@i</a>
                }
                <a href="?page=@(Model.PageNumber + 1)&pending=@ViewBag.ShowPendingOnly" class="px-3 py-2 rounded-lg border @(Model.HasNextPage ? "hover:bg-gray-50" : "opacity-50 pointer-events-none")">بعدی</a>
            </div>
        }
    </div>
</div>

<script>
    async function approveReview(reviewId) {
        const response = await fetch('/admin/approve-review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reviewId })
        });

        if (response.ok) {
            showToast('نظر با موفقیت تأیید شد', 'success');
            setTimeout(() => location.reload(), 500);
        }
    }

    async function deleteReview(reviewId) {
        const result = await Swal.fire({
            title: 'حذف نظر',
            text: 'آیا از حذف این نظر اطمینان دارید؟',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'بله، حذف',
            cancelButtonText: 'انصراف'
        });

        if (result.isConfirmed) {
            const response = await fetch('/admin/delete-review', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reviewId })
            });

            if (response.ok) {
                showToast('نظر با موفقیت حذف شد', 'success');
                setTimeout(() => location.reload(), 500);
            }
        }
    }
</script>