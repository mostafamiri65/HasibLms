@model HasibLms.Shared.DTOs.PagedResultDto<HasibLms.Shared.DTOs.Instructor.InstructorRequestListDto>
@{
    ViewBag.Title = "درخواست‌های مدرس شدن";
    Layout = "_AdminLayout";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">درخواست‌های مدرس شدن</h1>
            <p class="text-gray-500 dark:text-gray-400">مدیریت درخواست‌های کاربران برای تبدیل شدن به مدرس</p>
        </div>
        <div class="flex gap-2">
            <a href="?status=pending" class="px-3 py-2 rounded-lg @(ViewBag.CurrentStatus == "pending" ? "bg-yellow-100 text-yellow-700" : "bg-gray-100")">در انتظار</a>
            <a href="?status=approved" class="px-3 py-2 rounded-lg @(ViewBag.CurrentStatus == "approved" ? "bg-green-100 text-green-700" : "bg-gray-100")">تأیید شده</a>
            <a href="?status=rejected" class="px-3 py-2 rounded-lg @(ViewBag.CurrentStatus == "rejected" ? "bg-red-100 text-red-700" : "bg-gray-100")">رد شده</a>
            <a href="." class="px-3 py-2 rounded-lg bg-gray-100">همه</a>
        </div>
    </div>

    <div class="space-y-4">
        @foreach (var request in Model.Items)
        {
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md overflow-hidden">
                <div class="p-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center">
                                    <span class="text-white font-bold text-lg">@(request.FullName?.Substring(0, 1) ?? "ک")</span>
                                </div>
                                <div>
                                    <h3 class="text-lg font-bold text-gray-800 dark:text-white">@request.FullName</h3>
                                    <p class="text-sm text-gray-500">@request.Email</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <span class="px-3 py-1 rounded-full text-sm bg-@request.StatusColor-100 text-@request.StatusColor-700">
                                @request.StatusText
                            </span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 pt-4 border-t">
                        <div>
                            <p class="text-xs text-gray-500">مدرک تحصیلی</p>
                            <p class="text-sm font-medium">@(request.Degree ?? "-")</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500">دانشگاه</p>
                            <p class="text-sm font-medium">@(request.University ?? "-")</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500">سال‌های تجربه</p>
                            <p class="text-sm font-medium">@(request.YearsOfExperience?.ToString() ?? "-") سال</p>
                        </div>
                        <div class="md:col-span-2">
                            <p class="text-xs text-gray-500">حوزه تخصصی</p>
                            <p class="text-sm font-medium">@(request.Expertise ?? "-")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(request.Bio))
                    {
                        <div class="mt-3">
                            <p class="text-xs text-gray-500">بیوگرافی</p>
                            <p class="text-sm">@request.Bio</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(request.RejectReason))
                    {
                        <div class="mt-3 p-3 bg-red-50 rounded-lg">
                            <p class="text-xs text-red-500">دلیل رد</p>
                            <p class="text-sm text-red-700">@request.RejectReason</p>
                        </div>
                    }

                    <div class="flex justify-between items-center mt-4 pt-4 border-t">
                        <div class="text-xs text-gray-500">
                            تاریخ درخواست: @request.RequestedAt.ToString("yyyy/MM/dd - HH:mm")
                            @if (request.ReviewedAt.HasValue)
                            {
                                <span> | بررسی شده: @request.ReviewedAt.Value.ToString("yyyy/MM/dd - HH:mm")</span>
                            }
                        </div>
                        <div class="flex gap-2">
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <button onclick="showReviewModal('@request.Id', true)" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">
                                    <i class="fas fa-check ml-1"></i>تأیید
                                </button>
                                <button onclick="showReviewModal('@request.Id', false)" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">
                                    <i class="fas fa-times ml-1"></i>رد
                                </button>
                            }
                            <button onclick="viewDetails('@request.Id')" class="px-4 py-2 border rounded-lg hover:bg-gray-50">
                                <i class="fas fa-eye ml-1"></i>جزئیات
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl">
            <i class="fas fa-users text-6xl text-gray-300 mb-4"></i>
            <p class="text-gray-500">هیچ درخواستی یافت نشد</p>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-center gap-2 mt-6">
            <a href="?page=@(Model.PageNumber - 1)&status=@ViewBag.CurrentStatus" class="px-3 py-2 rounded-lg border">قبلی</a>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="?page=@i&status=@ViewBag.CurrentStatus" class="px-3 py-2 rounded-lg border @(i == Model.PageNumber ? "bg-primary-600 text-white" : "")">@i</a>
            }
            <a href="?page=@(Model.PageNumber + 1)&status=@ViewBag.CurrentStatus" class="px-3 py-2 rounded-lg border">بعدی</a>
        </div>
    }
</div>

<!-- Review Modal -->
<div id="reviewModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl w-full max-w-md p-6">
        <h3 id="modalTitle" class="text-xl font-bold mb-4">بررسی درخواست</h3>
        <input type="hidden" id="requestId">
        <input type="hidden" id="isApprove">
        <div id="rejectReasonDiv" class="hidden mb-4">
            <label class="block text-sm font-medium mb-1">دلیل رد</label>
            <textarea id="rejectReason" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="لطفاً دلیل رد را وارد کنید..."></textarea>
        </div>
        <div class="flex justify-end gap-3 mt-6">
            <button onclick="closeModal()" class="px-4 py-2 border rounded-lg">انصراف</button>
            <button onclick="submitReview()" class="px-4 py-2 bg-primary-600 text-white rounded-lg">تأیید</button>
        </div>
    </div>
</div>

<script>
    let currentRequestId = null;
    let currentIsApprove = false;

    function showReviewModal(requestId, isApprove) {
        currentRequestId = requestId;
        currentIsApprove = isApprove;

        document.getElementById('requestId').value = requestId;
        document.getElementById('isApprove').value = isApprove;

        if (isApprove) {
            document.getElementById('modalTitle').textContent = 'تأیید درخواست';
            document.getElementById('rejectReasonDiv').classList.add('hidden');
        } else {
            document.getElementById('modalTitle').textContent = 'رد درخواست';
            document.getElementById('rejectReasonDiv').classList.remove('hidden');
        }

        document.getElementById('reviewModal').classList.remove('hidden');
        document.getElementById('reviewModal').classList.add('flex');
    }

    async function submitReview() {
        const requestId = currentRequestId;
        const isApproved = currentIsApprove;
        const rejectReason = isApproved ? null : document.getElementById('rejectReason').value;

        if (!isApproved && !rejectReason) {
            Swal.fire({
                title: 'خطا!',
                text: 'لطفاً دلیل رد را وارد کنید',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
            return;
        }

        Swal.fire({
            title: 'در حال پردازش...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const url = `/admin/ReviewInstructorRequest?requestId=${requestId}&isApproved=${isApproved}&rejectReason=${encodeURIComponent(rejectReason || '')}`;

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const contentType = response.headers.get('content-type');

            if (contentType && contentType.includes('application/json')) {
                const result = await response.json();
                Swal.close();

                if (result.success) {
                    Swal.fire({
                        title: 'موفق!',
                        text: result.message,
                        icon: 'success',
                        confirmButtonText: 'باشه'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'خطا!',
                        text: result.message,
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                }
            } else {
                Swal.close();
                location.reload();
            }
        } catch (error) {
            Swal.close();
            console.error('Error:', error);
            Swal.fire({
                title: 'خطا!',
                text: 'خطا در ارتباط با سرور. لطفاً مجدداً تلاش کنید.',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
        }
    }

    function viewDetails(requestId) {
        window.location.href = `/admin/ViewInstructorRequest/${requestId}`;
    }

    function closeModal() {
        document.getElementById('reviewModal').classList.add('hidden');
        document.getElementById('reviewModal').classList.remove('flex');
        document.getElementById('rejectReason').value = '';
    }
</script>