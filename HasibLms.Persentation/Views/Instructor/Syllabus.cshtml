@model HasibLms.Shared.DTOs.CourseDetailDto
@{
    ViewBag.Title = "مدیریت سرفصل‌ها";
    Layout = "_InstructorLayout";
    var course = ViewBag.Course as CourseDetailDto;
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-xl font-bold text-gray-800 dark:text-white">مدیریت سرفصل‌ها</h1>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">دوره: @course?.Title</p>
                </div>
                <button onclick="showAddSyllabusModal()" class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 text-sm">
                    <i class="fas fa-plus ml-1"></i>سرفصل جدید
                </button>
            </div>
        </div>

        <div class="p-6">
            <div id="syllabusList" class="space-y-3">
                @foreach (var syllabus in Model.Syllabuses.OrderBy(s => s.Order))
                {
                    <div class="border rounded-lg overflow-hidden" data-syllabus-id="@syllabus.Id">
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 cursor-move">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-grip-vertical text-gray-400 drag-handle"></i>
                                <i class="fas fa-folder-open text-primary-600"></i>
                                <span class="font-medium">@syllabus.Title</span>
                                <span class="text-xs text-gray-500">(@syllabus.Lessons.Count جلسه)</span>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="editSyllabus('@syllabus.Id', '@syllabus.Title', '@syllabus.Description')" class="p-1 text-blue-600 hover:bg-blue-50 rounded">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button onclick="deleteSyllabus('@syllabus.Id')" class="p-1 text-red-600 hover:bg-red-50 rounded">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="p-4">
                            <div class="flex justify-between items-center mb-3">
                                <h4 class="text-sm font-medium text-gray-700">جلسات</h4>
                                <button onclick="showAddLessonModal('@syllabus.Id')" class="text-xs text-primary-600 hover:text-primary-700">
                                    <i class="fas fa-plus ml-1"></i>جلسه جدید
                                </button>
                            </div>
                            <div id="lessons-@syllabus.Id" class="space-y-2">
                                @foreach (var lesson in syllabus.Lessons.OrderBy(l => l.Order))
                                {
                                    <div class="flex items-center justify-between p-3 border rounded-lg bg-white dark:bg-gray-800">
                                        <div class="flex items-center gap-3">
                                            <i class="fas fa-play-circle text-primary-500"></i>
                                            <div>
                                                <p class="font-medium">@lesson.Title</p>
                                                <p class="text-xs text-gray-500">@lesson.DurationMinutes دقیقه</p>
                                            </div>
                                            @if (lesson.IsPreview)
                                            {
                                                <span class="px-1.5 py-0.5 bg-green-100 text-green-700 text-xs rounded">پیش‌نمایش</span>
                                            }
                                        </div>
                                        <div class="flex gap-1">
                                            <button onclick="editLesson('@lesson.Id', '@lesson.Title', '@lesson.DurationMinutes', @lesson.IsPreview.ToString().ToLower(), '@lesson.VideoUrl')" class="p-1 text-blue-600 hover:bg-blue-50 rounded">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button onclick="deleteLesson('@lesson.Id')" class="p-1 text-red-600 hover:bg-red-50 rounded">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                                @if (!syllabus.Lessons.Any())
                                {
                                    <p class="text-center text-gray-500 text-sm py-2">هیچ جلسه‌ای وجود ندارد</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Syllabuses.Any())
            {
                <div class="text-center py-12">
                    <i class="fas fa-folder-open text-5xl text-gray-300 mb-3"></i>
                    <p class="text-gray-500">هیچ سرفصلی وجود ندارد</p>
                    <button onclick="showAddSyllabusModal()" class="mt-3 px-4 py-2 bg-primary-600 text-white rounded-lg text-sm">افزودن اولین سرفصل</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Syllabus Modal -->
<div id="syllabusModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl w-full max-w-md p-6">
        <h3 id="syllabusModalTitle" class="text-xl font-bold mb-4">سرفصل جدید</h3>
        <input type="hidden" id="syllabusId">
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">عنوان سرفصل</label>
                <input type="text" id="syllabusTitle" class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">توضیحات</label>
                <textarea id="syllabusDescription" rows="3" class="w-full px-4 py-2 border rounded-lg"></textarea>
            </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
            <button onclick="closeModal('syllabusModal')" class="px-4 py-2 border rounded-lg">انصراف</button>
            <button onclick="saveSyllabus()" class="px-4 py-2 bg-primary-600 text-white rounded-lg">ذخیره</button>
        </div>
    </div>
</div>

<!-- Add/Edit Lesson Modal -->
<div id="lessonModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl w-full max-w-lg p-6">
        <h3 id="lessonModalTitle" class="text-xl font-bold mb-4">جلسه جدید</h3>
        <input type="hidden" id="lessonId">
        <input type="hidden" id="currentSyllabusId">
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">عنوان جلسه</label>
                <input type="text" id="lessonTitle" class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">مدت زمان (دقیقه)</label>
                <input type="number" id="lessonDuration" class="w-full px-4 py-2 border rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">لینک ویدیو</label>
                <input type="url" id="lessonVideoUrl" class="w-full px-4 py-2 border rounded-lg" placeholder="https://www.youtube.com/embed/...">
            </div>
            <div>
                <label class="flex items-center gap-2">
                    <input type="checkbox" id="lessonIsPreview">
                    <span class="text-sm">پیش‌نمایش رایگان</span>
                </label>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">محتوا (اختیاری)</label>
                <textarea id="lessonContent" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="متن آموزشی جلسه..."></textarea>
            </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
            <button onclick="closeModal('lessonModal')" class="px-4 py-2 border rounded-lg">انصراف</button>
            <button onclick="saveLesson()" class="px-4 py-2 bg-primary-600 text-white rounded-lg">ذخیره</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
    let currentSyllabusId = null;

    // Sortable for syllabus
    new Sortable(document.getElementById('syllabusList'), {
    handle: '.drag-handle',
    animation: 150,
    onEnd: function() {
    const syllabusIds = Array.from(document.querySelectorAll('[data-syllabus-id]')).map(el => el.dataset.syllabusId);
    reorderSyllabus(syllabusIds);
    }
    });

    async function reorderSyllabus(syllabusIds) {
    const response = await fetch('/instructor/reorder-syllabus', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(syllabusIds)
    });
    }

    function showAddSyllabusModal() {
    document.getElementById('syllabusModalTitle').textContent = 'سرفصل جدید';
    document.getElementById('syllabusId').value = '';
    document.getElementById('syllabusTitle').value = '';
    document.getElementById('syllabusDescription').value = '';
    document.getElementById('syllabusModal').classList.remove('hidden');
    document.getElementById('syllabusModal').classList.add('flex');
    }

    function editSyllabus(id, title, description) {
    document.getElementById('syllabusModalTitle').textContent = 'ویرایش سرفصل';
    document.getElementById('syllabusId').value = id;
    document.getElementById('syllabusTitle').value = title;
    document.getElementById('syllabusDescription').value = description || '';
    document.getElementById('syllabusModal').classList.remove('hidden');
    document.getElementById('syllabusModal').classList.add('flex');
    }

       async function saveSyllabus() {
        const id = document.getElementById('syllabusId').value;
        const courseId = '@course?.Id';
        const title = document.getElementById('syllabusTitle').value;
        const description = document.getElementById('syllabusDescription').value;

        if (!title) {
            Swal.fire({
                title: 'خطا!',
                text: 'عنوان سرفصل الزامی است',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
            return;
        }

        // نمایش لودینگ
        Swal.fire({
            title: 'در حال ذخیره...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const url = id ? '/instructor/updatesyllabus' : '/instructor/addsyllabus';
            const body = id ? { id: id, title: title, description: description } : { courseId: courseId, title: title, description: description };

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(body)
            });

            const result = await response.json();
            Swal.close();

            if (result.success) {
                Swal.fire({
                    title: 'موفق!',
                    text: result.message,
                    icon: 'success',
                    confirmButtonText: 'باشه'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    title: 'خطا!',
                    text: result.message,
                    icon: 'error',
                    confirmButtonText: 'باشه'
                });
            }
        } catch (error) {
            Swal.close();
            console.error('Error:', error);
            Swal.fire({
                title: 'خطا!',
                text: 'خطا در ارتباط با سرور',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
        }
    }

    async function deleteSyllabus(id) {
    const result = await Swal.fire({
    title: 'حذف سرفصل',
    text: 'آیا از حذف این سرفصل اطمینان دارید؟',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'بله، حذف',
    cancelButtonText: 'انصراف'
    });

    if (result.isConfirmed) {
    const response = await fetch('/instructor/deletesyllabus', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ syllabusId: id })
    });

    const data = await response.json();
    if (data.success) {
    showToast(data.message, 'success');
    setTimeout(() => location.reload(), 500);
    }
    }
    }

    function showAddLessonModal(syllabusId) {
    currentSyllabusId = syllabusId;
    document.getElementById('lessonModalTitle').textContent = 'جلسه جدید';
    document.getElementById('lessonId').value = '';
    document.getElementById('lessonTitle').value = '';
    document.getElementById('lessonDuration').value = '';
    document.getElementById('lessonVideoUrl').value = '';
    document.getElementById('lessonIsPreview').checked = false;
    document.getElementById('lessonContent').value = '';
    document.getElementById('lessonModal').classList.remove('hidden');
    document.getElementById('lessonModal').classList.add('flex');
    }

    function editLesson(id, title, duration, isPreview, videoUrl) {
    document.getElementById('lessonModalTitle').textContent = 'ویرایش جلسه';
    document.getElementById('lessonId').value = id;
    document.getElementById('lessonTitle').value = title;
    document.getElementById('lessonDuration').value = duration;
    document.getElementById('lessonVideoUrl').value = videoUrl || '';
    document.getElementById('lessonIsPreview').checked = isPreview;
    document.getElementById('lessonContent').value = '';
    document.getElementById('lessonModal').classList.remove('hidden');
    document.getElementById('lessonModal').classList.add('flex');
    }
    async function saveLesson() {
        const id = document.getElementById('lessonId').value;
        const syllabusId = currentSyllabusId;
        const title = document.getElementById('lessonTitle').value;
        const durationMinutes = parseInt(document.getElementById('lessonDuration').value) || 0;
        const videoUrl = document.getElementById('lessonVideoUrl').value;
        const isPreview = document.getElementById('lessonIsPreview').checked;
        const content = document.getElementById('lessonContent').value;

        if (!title) {
            Swal.fire({
                title: 'خطا!',
                text: 'عنوان جلسه الزامی است',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
            return;
        }

        Swal.fire({
            title: 'در حال ذخیره...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const url = id ? '/instructor/updatelesson' : '/instructor/addlesson';
            const body = id
                ? { id: id, title: title, durationMinutes: durationMinutes, videoUrl: videoUrl, isPreview: isPreview, content: content }
                : { syllabusId: syllabusId, title: title, durationMinutes: durationMinutes, videoUrl: videoUrl, isPreview: isPreview, content: content };

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(body)
            });

            const result = await response.json();
            Swal.close();

            if (result.success) {
                Swal.fire({
                    title: 'موفق!',
                    text: result.message,
                    icon: 'success',
                    confirmButtonText: 'باشه'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    title: 'خطا!',
                    text: result.message,
                    icon: 'error',
                    confirmButtonText: 'باشه'
                });
            }
        } catch (error) {
            Swal.close();
            console.error('Error:', error);
            Swal.fire({
                title: 'خطا!',
                text: 'خطا در ارتباط با سرور',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
        }
    }
    async function deleteLesson(id) {
    const result = await Swal.fire({
    title: 'حذف جلسه',
    text: 'آیا از حذف این جلسه اطمینان دارید؟',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'بله، حذف',
    cancelButtonText: 'انصراف'
    });

    if (result.isConfirmed) {
    const response = await fetch('/instructor/deletelesson', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ lessonId: id })
    });

    const data = await response.json();
    if (data.success) {
    showToast(data.message, 'success');
    setTimeout(() => location.reload(), 500);
    }
    }
    }

    function closeModal(modalId) {
    document.getElementById(modalId).classList.add('hidden');
    document.getElementById(modalId).classList.remove('flex');
    }
</script>