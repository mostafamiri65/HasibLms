@model HasibLms.Shared.DTOs.Settings.SiteSettingsDto
@{
    ViewBag.Title = "تماس با ما";
}

<!-- Header -->
<section class="relative bg-gradient-to-br from-primary-700 to-primary-900 py-16">
    <div class="container mx-auto px-4 text-center text-white">
        <h1 class="text-3xl md:text-5xl font-bold mb-4" data-aos="fade-up">تماس با ما</h1>
        <p class="text-white/80 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            ما همیشه آماده پاسخگویی به سوالات و نظرات شما هستیم
        </p>
    </div>
</section>

<div class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Contact Form -->
        <div class="lg:w-1/2" data-aos="fade-up">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-6 md:p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-2">ارسال پیام</h2>
                <p class="text-gray-500 dark:text-gray-400 mb-6">سوالات، نظرات و پیشنهادات خود را با ما در میان بگذارید</p>

                <form id="contactForm" method="post" action="/contact">
                    @Html.AntiForgeryToken()

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">نام و نام خانوادگی *</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <i class="fas fa-user text-gray-400"></i>
                                </div>
                                <input type="text" name="name" required
                                       class="w-full pr-10 pl-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                                       placeholder="نام و نام خانوادگی">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ایمیل *</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <i class="fas fa-envelope text-gray-400"></i>
                                </div>
                                <input type="email" name="email" required
                                       class="w-full pr-10 pl-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                                       placeholder="example@mail.com">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">شماره تماس</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <i class="fas fa-phone text-gray-400"></i>
                                </div>
                                <input type="tel" name="phone"
                                       class="w-full pr-10 pl-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                                       placeholder="0912 123 4567">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">پیام *</label>
                            <textarea name="message" rows="5" required
                                      class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                                      placeholder="پیام شما..."></textarea>
                        </div>

                        <button type="submit"
                                class="w-full py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold transition-all transform hover:-translate-y-0.5 shadow-lg">
                            <i class="fas fa-paper-plane ml-2"></i>
                            ارسال پیام
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="lg:w-1/2" data-aos="fade-up" data-aos-delay="100">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-6 md:p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-6">اطلاعات تماس</h2>

                <div class="space-y-6">
                    <!-- Address -->
                    <div class="flex gap-4">
                        <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-map-marker-alt text-primary-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 dark:text-white">آدرس</h3>
                            <p class="text-gray-500 dark:text-gray-400">@(Model?.Address ?? "تهران، خیابان ولیعصر، پلاک 123")</p>
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="flex gap-4">
                        <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-phone text-primary-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 dark:text-white">تلفن تماس</h3>
                            <p class="text-gray-500 dark:text-gray-400">@(Model?.Phone ?? "021-12345678")</p>
                            <p class="text-gray-500 dark:text-gray-400">@(Model?.Mobile ?? "0912-1234567")</p>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="flex gap-4">
                        <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-envelope text-primary-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 dark:text-white">ایمیل</h3>
                            <p class="text-gray-500 dark:text-gray-400">@(Model?.Email ?? "info@maliba.com")</p>
                        </div>
                    </div>

                    <!-- Working Hours -->
                    <div class="flex gap-4">
                        <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-clock text-primary-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 dark:text-white">ساعات کاری</h3>
                            <p class="text-gray-500 dark:text-gray-400">شنبه تا چهارشنبه: 9:00 - 18:00</p>
                            <p class="text-gray-500 dark:text-gray-400">پنجشنبه: 9:00 - 13:00</p>
                        </div>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-700">
                    <h3 class="font-semibold text-gray-800 dark:text-white mb-4">شبکه‌های اجتماعی</h3>
                    <div class="flex gap-3">
                        @if (!string.IsNullOrEmpty(Model?.Telegram))
                        {
                            <a href="@Model.Telegram" target="_blank" class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-blue-500 hover:text-white transition-all">
                                <i class="fab fa-telegram"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Instagram))
                        {
                            <a href="@Model.Instagram" target="_blank" class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-gradient-to-tr hover:from-pink-500 hover:to-orange-500 hover:text-white transition-all">
                                <i class="fab fa-instagram"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model?.LinkedIn))
                        {
                            <a href="@Model.LinkedIn" target="_blank" class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-blue-700 hover:text-white transition-all">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model?.YouTube))
                        {
                            <a href="@Model.YouTube" target="_blank" class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-red-600 hover:text-white transition-all">
                                <i class="fab fa-youtube"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Google Map -->
    @if (!string.IsNullOrEmpty(Model?.GoogleMapEmbed))
    {
        <div class="mt-12" data-aos="fade-up">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
                <div class="h-96">
                    @Html.Raw(Model.GoogleMapEmbed)
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('contactForm')?.addEventListener('submit', function(e) {
            // Form submission handled by server
        });
    </script>
}