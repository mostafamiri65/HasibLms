@model HasibLms.Shared.DTOs.Auth.ForgotPasswordDto
@{
    ViewBag.Title = "فراموشی رمز عبور";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8" data-aos="fade-up">
        <div class="text-center mb-8">
            <div class="mx-auto h-16 w-16 bg-gradient-to-br from-primary-600 to-primary-800 rounded-2xl flex items-center justify-center">
                <i class="fas fa-key text-white text-2xl"></i>
            </div>
            <h2 class="mt-4 text-2xl font-bold text-gray-800 dark:text-white">فراموشی رمز عبور</h2>
            <p class="mt-2 text-gray-500 dark:text-gray-400">
                ایمیل خود را وارد کنید، لینک بازیابی برای شما ارسال می‌شود
            </p>
        </div>

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ایمیل</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-400"></i>
                        </div>
                        <input asp-for="Email" type="email" required
                               class="w-full pr-10 pl-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500"
                               placeholder="example@mail.com">
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                </div>

                <button type="submit"
                        class="w-full py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold transition-all transform hover:-translate-y-0.5">
                    ارسال لینک بازیابی
                </button>
            </div>

            <div class="text-center mt-6">
                <a href="/auth/login" class="text-primary-600 hover:text-primary-700 text-sm">
                    <i class="fas fa-arrow-right ml-1"></i>
                    بازگشت به صفحه ورود
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}