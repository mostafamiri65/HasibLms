@model HasibLms.Shared.DTOs.Instructor.ApplyForInstructorDto
@{
    ViewBag.Title = "درخواست مدرس شدن";
}

<div class="max-w-4xl mx-auto py-12 px-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
        <div class="px-6 py-4 bg-gradient-to-r from-primary-600 to-primary-800">
            <h1 class="text-2xl font-bold text-white">درخواست مدرس شدن</h1>
            <p class="text-white/80 text-sm">لطفاً اطلاعات خود را کامل وارد کنید</p>
        </div>

        <form method="post" class="p-6 space-y-6">
            @Html.AntiForgeryToken()

            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4 mb-6">
                <div class="flex items-center gap-3">
                    <i class="fas fa-info-circle text-blue-500 text-xl"></i>
                    <div>
                        <p class="text-sm text-gray-700 dark:text-gray-300">
                            با ثبت این درخواست، اطلاعات شما برای ادمین ارسال می‌شود. پس از تأیید، شما می‌توانید دوره‌های خود را ثبت کنید.
                        </p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2">
                    <label asp-for="FullName" class="block text-sm font-medium mb-1">نام و نام خانوادگی <span class="text-red-500">*</span></label>
                    <input asp-for="FullName" class="w-full px-4 py-2 border rounded-lg focus:ring-primary-500">
                    <span asp-validation-for="FullName" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium mb-1">ایمیل <span class="text-red-500">*</span></label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-2 border rounded-lg">
                    <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium mb-1">شماره موبایل</label>
                    <input asp-for="PhoneNumber" class="w-full px-4 py-2 border rounded-lg">
                </div>

                <div>
                    <label asp-for="Degree" class="block text-sm font-medium mb-1">مدرک تحصیلی</label>
                    <select asp-for="Degree" class="w-full px-4 py-2 border rounded-lg">
                        <option value="">انتخاب کنید...</option>
                        <option>کارشناسی</option>
                        <option>کارشناسی ارشد</option>
                        <option>دکتری</option>
                        <option>فوق دکتری</option>
                    </select>
                </div>

                <div>
                    <label asp-for="University" class="block text-sm font-medium mb-1">دانشگاه</label>
                    <input asp-for="University" class="w-full px-4 py-2 border rounded-lg">
                </div>

                <div>
                    <label asp-for="YearsOfExperience" class="block text-sm font-medium mb-1">سال‌های تجربه</label>
                    <input asp-for="YearsOfExperience" type="number" class="w-full px-4 py-2 border rounded-lg">
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Expertise" class="block text-sm font-medium mb-1">حوزه تخصصی</label>
                    <input asp-for="Expertise" class="w-full px-4 py-2 border rounded-lg" placeholder="مثال: حسابداری مالی، مالیات، سرمایه‌گذاری...">
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Bio" class="block text-sm font-medium mb-1">بیوگرافی</label>
                    <textarea asp-for="Bio" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="درباره خود بنویسید..."></textarea>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="TeachingExperience" class="block text-sm font-medium mb-1">سابقه تدریس</label>
                    <textarea asp-for="TeachingExperience" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="سابقه تدریس خود را شرح دهید..."></textarea>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="SampleWorkUrl" class="block text-sm font-medium mb-1">لینک نمونه کار</label>
                    <input asp-for="SampleWorkUrl" class="w-full px-4 py-2 border rounded-lg" placeholder="https://...">
                </div>

                <div>
                    <label asp-for="ResumeUrl" class="block text-sm font-medium mb-1">لینک فایل رزومه</label>
                    <input asp-for="ResumeUrl" class="w-full px-4 py-2 border rounded-lg" placeholder="Google Drive / Dropbox link">
                </div>

                <div>
                    <label asp-for="CertificateUrl" class="block text-sm font-medium mb-1">لینک فایل مدرک</label>
                    <input asp-for="CertificateUrl" class="w-full px-4 py-2 border rounded-lg" placeholder="Google Drive / Dropbox link">
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t">
                <a href="/profile" class="px-6 py-2 border rounded-lg hover:bg-gray-50">انصراف</a>
                <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">
                    <i class="fas fa-paper-plane ml-2"></i>ارسال درخواست
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}