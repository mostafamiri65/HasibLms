@model HasibLms.Shared.DTOs.Auth.RegisterDto
@{
    ViewBag.Title = "ثبت نام در سایت";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8" data-aos="fade-up">
        <!-- Header -->
        <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-gradient-to-br from-primary-600 to-primary-800 rounded-xl flex items-center justify-center">
                <i class="fas fa-user-plus text-white text-xl"></i>
            </div>
            <h2 class="mt-6 text-3xl font-extrabold text-gray-900 dark:text-white">
                ثبت نام
            </h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                برای استفاده از خدمات مالیبا ثبت نام کنید
            </p>
        </div>

        <!-- Form -->
        <form class="mt-8 space-y-6" asp-action="Register" method="post">
            <div class="space-y-4">
                <!-- Full Name -->
                <div>
                    <label asp-for="FullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        نام و نام خانوادگی
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-user text-gray-400"></i>
                        </div>
                        <input asp-for="FullName"
                               class="appearance-none rounded-xl relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 text-gray-900 dark:text-white dark:bg-gray-700 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                               placeholder="نام و نام خانوادگی">
                    </div>
                    <span asp-validation-for="FullName" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        ایمیل
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-envelope text-gray-400"></i>
                        </div>
                        <input asp-for="Email"
                               type="email"
                               class="appearance-none rounded-xl relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 text-gray-900 dark:text-white dark:bg-gray-700 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                               placeholder="example@mail.com">
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Phone -->
                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        شماره موبایل (اختیاری)
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-phone text-gray-400"></i>
                        </div>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="appearance-none rounded-xl relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 text-gray-900 dark:text-white dark:bg-gray-700 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                               placeholder="0912 123 4567">
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        رمز عبور
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-lock text-gray-400"></i>
                        </div>
                        <input asp-for="Password"
                               type="password"
                               class="appearance-none rounded-xl relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 text-gray-900 dark:text-white dark:bg-gray-700 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                               placeholder="••••••••">
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                    <p class="text-xs text-gray-500 mt-1">حداقل 6 کاراکتر</p>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                        تکرار رمز عبور
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <i class="fas fa-lock text-gray-400"></i>
                        </div>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="appearance-none rounded-xl relative block w-full px-3 py-3 pr-10 border border-gray-300 dark:border-gray-600 placeholder-gray-500 text-gray-900 dark:text-white dark:bg-gray-700 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm"
                               placeholder="••••••••">
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <!-- Terms -->
            <div class="flex items-center">
                <input type="checkbox" required
                       class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
                <label class="mr-2 block text-sm text-gray-700 dark:text-gray-300">
                    <a href="/terms" class="text-primary-600 hover:text-primary-500">قوانین و مقررات</a> را می‌پذیرم
                </label>
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit"
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-xl text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all transform hover:-translate-y-0.5">
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <i class="fas fa-user-plus group-hover:scale-110 transition-transform"></i>
                    </span>
                    ثبت نام
                </button>
            </div>

            <!-- Login Link -->
            <div class="text-center">
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    قبلاً ثبت نام کرده‌اید؟
                    <a href="/auth/login" class="font-medium text-primary-600 hover:text-primary-500">
                        وارد شوید
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}