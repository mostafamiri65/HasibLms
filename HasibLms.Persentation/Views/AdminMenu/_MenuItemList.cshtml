@model List<HasibLms.Shared.DTOs.Settings.MenuItemDto>

@if (!Model.Any())
{
    <div class="text-center py-4 text-gray-400 dark:text-gray-500">
        <i class="fas fa-inbox text-2xl block mb-2"></i>
        <span>هیچ منویی تعریف نشده است</span>
    </div>
}
else
{
    <div class="space-y-2">
        @foreach (var item in Model)
        {
            <div class="menu-item bg-gray-50 dark:bg-gray-700 rounded-lg p-3 flex items-center justify-between" data-id="@item.Id">
                <div class="flex items-center gap-3">
                    <i class="fas fa-grip-vertical text-gray-400 cursor-move"></i>
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon text-primary-500"></i>
                    }
                    <span class="font-medium text-gray-800 dark:text-white">@item.Title</span>
                    @if (!string.IsNullOrEmpty(item.Url))
                    {
                        <span class="text-sm text-gray-400">→ @item.Url</span>
                    }
                    @if (!item.IsActive)
                    {
                        <span class="px-2 py-0.5 text-xs bg-red-100 text-red-600 rounded-full">غیرفعال</span>
                    }
                    @if (item.Children?.Any() == true)
                    {
                        <span class="px-2 py-0.5 text-xs bg-blue-100 text-blue-600 rounded-full">@item.Children.Count زیرمنو</span>
                    }
                </div>
                <div class="flex items-center gap-2">
                    <a href="/admin/menu/edit/@item.Id" class="text-blue-500 hover:text-blue-700">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button onclick="deleteMenuItem('@item.Id')" class="text-red-500 hover:text-red-700">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
            
            @if (item.Children?.Any() == true)
            {
                <div class="mr-8 space-y-2">
                    @foreach (var child in item.Children)
                    {
                        <div class="menu-item bg-gray-100 dark:bg-gray-600 rounded-lg p-3 flex items-center justify-between" data-id="@child.Id">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-grip-vertical text-gray-400 cursor-move"></i>
                                <i class="fas fa-level-down-alt text-gray-400 text-sm"></i>
                                @if (!string.IsNullOrEmpty(child.Icon))
                                {
                                    <i class="@child.Icon text-primary-500"></i>
                                }
                                <span class="font-medium text-gray-800 dark:text-white">@child.Title</span>
                                @if (!string.IsNullOrEmpty(child.Url))
                                {
                                    <span class="text-sm text-gray-400">→ @child.Url</span>
                                }
                                @if (!child.IsActive)
                                {
                                    <span class="px-2 py-0.5 text-xs bg-red-100 text-red-600 rounded-full">غیرفعال</span>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                <a href="/admin/menu/edit/@child.Id" class="text-blue-500 hover:text-blue-700">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button onclick="deleteMenuItem('@child.Id')" class="text-red-500 hover:text-red-700">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
}