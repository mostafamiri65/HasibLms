@model List<HasibLms.Shared.DTOs.CourseCardDto>
@{
    ViewBag.Title = "دوره‌های من";
}

<section class="py-12">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white">دوره‌های من</h1>
                <p class="text-gray-500 dark:text-gray-400 mt-1">دوره‌هایی که در آنها ثبت نام کرده‌اید</p>
            </div>
            <a href="/course" class="px-4 py-2 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors">
                <i class="fas fa-plus ml-2"></i>دوره جدید
            </a>
        </div>

        @if (Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var course in Model)
                {
                    <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all group">
                        <div class="relative h-48 overflow-hidden">
                            <img src="@(course.ImageUrl ?? "/images/course-placeholder.jpg")"
                                 alt="@course.Title"
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                                <a href="/course/learn/@course.Slug" class="w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-primary-600 hover:text-white transition-colors">
                                    <i class="fas fa-play"></i>
                                </a>
                                <a href="/course/@course.Slug" class="w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-primary-600 hover:text-white transition-colors">
                                    <i class="fas fa-info"></i>
                                </a>
                            </div>
                        </div>
                        <div class="p-5">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs text-primary-600 bg-primary-50 dark:bg-primary-900/30 px-2 py-1 rounded-full">
                                    @course.CategoryName
                                </span>
                                <div class="flex text-yellow-400 text-xs">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas @(i <= (int)Math.Floor(course.AverageRating) ? "fa-star" : "fa-star-o")"></i>
                                    }
                                </div>
                            </div>
                            <h3 class="font-bold text-gray-800 dark:text-white text-lg mb-2">
                                <a href="/course/@course.Slug" class="hover:text-primary-600">@course.Title</a>
                            </h3>
                            <p class="text-gray-500 dark:text-gray-400 text-sm mb-3 line-clamp-2">@course.ShortDescription</p>
                            <div class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-gray-700">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center">
                                        <span class="text-white text-[10px] font-bold">@(course.InstructorName?.Substring(0, 1) ?? "م")</span>
                                    </div>
                                    <span class="text-gray-600 dark:text-gray-300 text-xs">@course.InstructorName</span>
                                </div>
                                <div class="flex items-center gap-1 text-gray-500 text-xs">
                                    <i class="fas fa-chart-line"></i>
                                    <span>@course.EnrolledCount% پیشرفت</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl">
                <i class="fas fa-book-open text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">شما در هیچ دوره‌ای ثبت نام نکرده‌اید</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-4">برای شروع یادگیری، اولین دوره خود را انتخاب کنید</p>
                <a href="/course" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors">
                    <i class="fas fa-graduation-cap"></i>
                    مشاهده دوره‌ها
                </a>
            </div>
        }
    </div>
</section>