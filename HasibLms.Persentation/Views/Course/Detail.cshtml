@model HasibLms.Shared.DTOs.CourseDetailDto
@using HasibLms.Domain.Interfaces
@inject ISiteService SiteService
@{
    var settings = await SiteService.GetSettingsAsync();
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<!-- Course Header -->
<section class="relative bg-gradient-to-br from-gray-900 to-gray-800 text-white py-12">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Course Image -->
            <div class="lg:w-1/3">
                <div class="rounded-2xl overflow-hidden shadow-2xl">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-auto" />
                    }
                    else
                    {
                        <div class="w-full aspect-video bg-gradient-to-br from-primary-600 to-primary-800 flex items-center justify-center">
                            <i class="fas fa-graduation-cap text-6xl text-white/50"></i>
                        </div>
                    }
                </div>
            </div>

            <!-- Course Info -->
            <div class="lg:w-2/3">
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-primary-600 rounded-full text-sm">@Model.CategoryName</span>
                    <span class="px-3 py-1 bg-white/10 rounded-full text-sm">@Model.CourseType</span>
                    @if (Model.IsUserEnrolled)
                    {
                        <span class="px-3 py-1 bg-green-600 rounded-full text-sm">
                            <i class="fas fa-check ml-1"></i> ثبت نام کرده‌اید
                        </span>
                    }
                </div>

                <h1 class="text-3xl lg:text-4xl font-bold mb-4">@Model.Title</h1>
                <p class="text-gray-300 text-lg mb-6">@Model.ShortDescription</p>

                <div class="flex flex-wrap gap-6 mb-6 text-sm">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-chalkboard-teacher text-primary-400"></i>
                        <span>مدرس: @Model.InstructorName</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fas fa-clock text-primary-400"></i>
                        <span>@Model.DurationHours ساعت</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fas fa-calendar text-primary-400"></i>
                        <span>شروع: @Model.StartDate.ToString("yyyy/MM/dd")</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fas fa-users text-primary-400"></i>
                        <span>@Model.EnrolledCount دانشجو</span>
                    </div>
                </div>

                <div class="flex items-center gap-4 mb-6">
                    <div class="flex text-yellow-400">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= (int)Math.Floor(Model.AverageRating))
                            {
                                <i class="fas fa-star"></i>
                            }
                            else if (i - Model.AverageRating < (double)0.6m)
                            {
                                <i class="fas fa-star-half-alt"></i>
                            }
                            else
                            {
                                <i class="far fa-star"></i>
                            }
                        }
                        <span class="text-white mr-2">(@Model.ReviewCount نظر)</span>
                    </div>
                    <div class="text-3xl font-bold">
                        @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
                        {
                            <span class="line-through text-gray-400 text-xl ml-2">@Model.Price.ToString("N0")</span>
                            <span>@Model.DiscountPrice.Value.ToString("N0")</span>
                        }
                        else
                        {
                            <span>@Model.Price.ToString("N0")</span>
                        }
                        <span class="text-sm font-normal text-gray-300"> @settings?.CurrencySymbol</span>
                    </div>
                </div>

                @if (!Model.IsUserEnrolled && Model.IsPublished)
                {
                    <button onclick="enrollInCourse('@Model.Id')"
                            class="w-full sm:w-auto px-8 py-3 bg-primary-600 hover:bg-primary-700 rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                        <i class="fas fa-shopping-cart ml-2"></i> ثبت نام در دوره
                    </button>
                }
                else if (Model.IsUserEnrolled)
                {
                    <div class="flex gap-3">
                        <a href="/course/learn/@Model.Slug" class="px-8 py-3 bg-green-600 hover:bg-green-700 rounded-xl font-semibold transition-all">
                            <i class="fas fa-play ml-2"></i> شروع یادگیری
                        </a>
                        <button class="px-4 py-3 bg-white/10 hover:bg-white/20 rounded-xl transition-all">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Course Content Tabs -->
<section class="py-12">
    <div class="container mx-auto px-4">
        <div class="flex border-b border-gray-200 dark:border-gray-700 mb-8" x-data="{ activeTab: 'description' }">
            <button @@click="activeTab = 'description'"
                :class="activeTab === 'description' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 border-b-2 font-medium transition-colors">
                توضیحات دوره
            </button>
            <button @@click="activeTab = 'syllabus'"
                :class="activeTab === 'syllabus' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 border-b-2 font-medium transition-colors">
                سرفصل‌ها
            </button>
            <button @@click="activeTab = 'reviews'"
                :class="activeTab === 'reviews' ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 border-b-2 font-medium transition-colors">
                نظرات (@Model.ReviewCount)
            </button>
        </div>

        <!-- Description Tab -->
        <div x-show="activeTab === 'description'" x-transition>
            <div class="prose prose-lg dark:prose-invert max-w-none">
                @Html.Raw(Model.Description)
            </div>
        </div>

        <!-- Syllabus Tab -->
        <div x-show="activeTab === 'syllabus'" x-transition>
            <div class="space-y-4">
                @foreach (var syllabus in Model.Syllabuses)
                {
                    <div class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden" x-data="{ open: @(syllabus.Order == 1 ? "true" : "false") }">
                        <button @@click="open = !open" class="w-full px-6 py-4 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-750 flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <i class="fas" :class="open ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                                <span class="font-semibold">بخش @syllabus.Order: @syllabus.Title</span>
                            </div>
                            <span class="text-sm text-gray-500">@syllabus.Lessons.Count جلسه</span>
                        </button>
                        <div x-show="open" x-transition class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var lesson in syllabus.Lessons)
                            {
                                <div class="px-6 py-3 flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <i class="fas @(lesson.IsPreview ? "fa-play-circle text-primary-600" : "fa-lock text-gray-400")"></i>
                                        <span>@lesson.Title</span>
                                        @if (lesson.IsPreview)
                                        {
                                            <span class="text-xs text-primary-600">پیش‌نمایش رایگان</span>
                                        }
                                    </div>
                                    <span class="text-sm text-gray-500">@(lesson.DurationMinutes) دقیقه</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Reviews Tab -->
        <div x-show="activeTab === 'reviews'" x-transition>
            <div class="space-y-6">
                @if (Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="border-b border-gray-100 dark:border-gray-800 pb-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center">
                                    <span class="text-white text-sm font-medium">@(review.StudentName?.Substring(0, 1) ?? "کاربر")</span>
                                </div>
                                <div>
                                    <div class="font-semibold">@review.StudentName</div>
                                    <div class="flex text-yellow-400 text-sm">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas @(i <= review.Rating ? "fa-star" : "fa-star-o")"></i>
                                        }
                                    </div>
                                </div>
                                <div class="text-xs text-gray-400 mr-auto">@review.CreatedAt.ToString("yyyy/MM/dd")</div>
                            </div>
                            <p class="text-gray-600 dark:text-gray-300">@review.Comment</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-12">
                        <i class="far fa-comment-dots text-5xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500">هنوز نظری برای این دوره ثبت نشده است</p>
                        @if (isLoggedIn && !Model.IsUserEnrolled)
                        {
                            <p class="text-sm text-gray-400 mt-2">برای ثبت نظر باید در دوره ثبت نام کنید</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Related Courses -->
@if (ViewBag.RelatedCourses != null && ((List<CourseCardDto>)ViewBag.RelatedCourses).Any())
{
    <section class="py-12 bg-gray-50 dark:bg-gray-900/50">
        <div class="container mx-auto px-4">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-6">دوره‌های مرتبط</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var course in (ViewBag.RelatedCourses as List<CourseCardDto>)!)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </div>
        </div>
    </section>
}

<script>
    function enrollInCourse(courseId) {
        @if (!isLoggedIn)
            {
                <text>
                    Swal.fire({
                        title: 'برای ثبت نام وارد شوید',
                        text: 'لطفاً ابتدا وارد حساب کاربری خود شوید',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'ورود',
                        cancelButtonText: 'بعداً'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/auth/login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }
                    });
            </text>
        }
            else
            {
                <text>
                    Swal.fire({
                        title: 'ثبت نام در دوره',
                        html: 'آیا از ثبت نام در این دوره اطمینان دارید؟',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'بله، ثبت نام',
                        cancelButtonText: 'انصراف'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            Swal.fire({
                                title: 'در حال ثبت نام...',
                                allowOutsideClick: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });

                            const response = await fetch('/course/enroll', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                                },
                                body: JSON.stringify({ courseId: courseId })
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    title: 'موفق!',
                                    text: data.message,
                                    icon: 'success',
                                    confirmButtonText: 'باشه'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    title: 'خطا!',
                                    text: data.message,
                                    icon: 'error',
                                    confirmButtonText: 'باشه'
                                });
                            }
                        }
                    });
            </text>
        }
        }
</script>