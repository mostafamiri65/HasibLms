@model HasibLms.Shared.DTOs.PagedResultDto<HasibLms.Shared.DTOs.CourseCardDto>
@using HasibLms.Domain.Interfaces
@inject ISiteService SiteService
@{
    var settings = await SiteService.GetSettingsAsync();
    ViewBag.Title = "دوره‌های آموزشی";
}

<!-- Header Section -->
<section class="relative bg-gradient-to-br from-primary-700 to-primary-900 py-16">
    <div class="container mx-auto px-4">
        <div class="text-center text-white" data-aos="fade-up">
            <h1 class="text-3xl md:text-5xl font-bold mb-4">دوره‌های آموزشی</h1>
            <p class="text-white/80 max-w-2xl mx-auto">
                @(settings?.Slogan ?? "دوره‌های تخصصی در حوزه حسابداری، مالیات، سرمایه‌گذاری و بودجه‌ریزی")
            </p>
        </div>
    </div>
</section>

<!-- Filters Section -->
<section class="sticky top-16 z-30 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 py-4">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-4 justify-between items-center">
            <!-- Search Bar -->
            <div class="w-full lg:w-96 relative">
                <form action="/course" method="get" class="relative">
                    <i class="fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text"
                           name="search"
                           value="@ViewBag.CurrentSearch"
                           placeholder="جستجوی دوره..."
                           class="w-full pr-10 pl-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500">
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
                    {
                        <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
                    }
                    <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />
                </form>
            </div>

            <!-- Filters Row -->
            <div class="flex flex-wrap gap-2 items-center">
                <!-- Category Filter -->
                <div class="relative" x-data="{ open: false }">
                    <button @@click="open = !open" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-xl flex items-center gap-2 text-sm">
                        <i class="fas fa-filter"></i>
                        <span>دسته‌بندی</span>
                        <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                    <div x-show="open"
                        @@click.away="open = false"
                         x-transition
                         class="absolute top-full right-0 mt-2 w-64 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 py-2 z-50">
                        <a href="/course" class="block px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20" : "text-gray-700")">
                            همه دوره‌ها
                        </a>
                        @foreach (var cat in ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>())
                        {
                            <a href="?category=@cat.Slug&sort=@ViewBag.CurrentSort"
                                   class="block px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(ViewBag.CurrentCategory == cat.Slug ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20" : "text-gray-700")">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <!-- Sort Filter -->
                <div class="relative" x-data="{ open: false }">
                    <button @@click="open = !open" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-xl flex items-center gap-2 text-sm">
                        <i class="fas fa-sort-amount-down"></i>
                        <span>مرتب‌سازی</span>
                        <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                    <div x-show="open"
                        @@click.away="open = false"
                         x-transition
                         class="absolute top-full right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 py-2 z-50">
                        @{
                            var sortOptions = new[] {
                            ("latest", "جدیدترین"),
                            ("popular", "محبوب‌ترین"),
                            ("rating", "بالاترین امتیاز"),
                            ("price_asc", "ارزان‌ترین"),
                            ("price_desc", "گران‌ترین")
                        };
                        }
                        @foreach (var (value, label) in sortOptions)
                        {
                            <a href="?category=@ViewBag.CurrentCategory&sort=@value&search=@ViewBag.CurrentSearch"
                                   class="block px-4 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(ViewBag.CurrentSort == value ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20" : "text-gray-700")">
                                @label
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Courses Grid -->
<section class="py-12">
    <div class="container mx-auto px-4">
        @if (Model.Items.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var course in Model.Items)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center mt-12">
                    <nav class="flex items-center gap-2" aria-label="Pagination">
                        <a href="@GetPageUrl(Model.PageNumber - 1)"
                               class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasPreviousPage ? "" : "opacity-50 pointer-events-none")">
                            <i class="fas fa-chevron-right"></i>
                        </a>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <a href="@GetPageUrl(i)"
                                       class="min-w-[40px] h-10 flex items-center justify-center rounded-lg border @(i == Model.PageNumber ? "bg-primary-600 text-white border-primary-600" : "border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800") transition-colors">
                                    @i
                                </a>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <span class="px-2">...</span>
                            }
                        }

                        <a href="@GetPageUrl(Model.PageNumber + 1)"
                               class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasNextPage ? "" : "opacity-50 pointer-events-none")">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16">
                <i class="fas fa-folder-open text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">هیچ دوره‌ای یافت نشد</h3>
                <p class="text-gray-500 dark:text-gray-400">لطفاً فیلترهای جستجو را تغییر دهید</p>
                <a href="/course" class="inline-block mt-4 px-6 py-2 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors">
                    حذف فیلترها
                </a>
            </div>
        }
    </div>
</section>

@functions {
    private string GetPageUrl(int page)
    {
        var queryParams = new List<string>();
        if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
            queryParams.Add($"category={ViewBag.CurrentCategory}");
        if (!string.IsNullOrEmpty(ViewBag.CurrentSort) && ViewBag.CurrentSort != "latest")
            queryParams.Add($"sort={ViewBag.CurrentSort}");
        if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
            queryParams.Add($"search={ViewBag.CurrentSearch}");
        queryParams.Add($"page={page}");

        return $"/course?{string.Join("&", queryParams)}";
    }
}