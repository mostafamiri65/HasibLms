@model HasibLms.Shared.DTOs.PagedResultDto<HasibLms.Shared.DTOs.CourseCardDto>
@using HasibLms.Domain.Interfaces
@inject ISiteService SiteService
@{
    ViewBag.Title = "دوره‌های آموزشی";
    var settings = await SiteService.GetSettingsAsync();
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
}

<!-- ==================== Header ==================== -->
<section class="relative bg-gradient-to-br from-primary-700 via-primary-800 to-primary-900 py-16 overflow-hidden">
    <!-- Decorative shapes -->
    <div class="absolute inset-0 opacity-30">
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-primary-500 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-primary-400 rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center text-white" data-aos="fade-up">
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-4">
                <i class="fas fa-graduation-cap"></i>
                <span class="text-sm">آموزش‌های تخصصی</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-bold mb-4">دوره‌های آموزشی</h1>
            <p class="text-white/80 max-w-2xl mx-auto text-lg">
                @(settings?.Slogan ?? "دوره‌های تخصصی در حوزه حسابداری، مالیات، سرمایه‌گذاری و بودجه‌ریزی")
            </p>
        </div>
    </div>
</section>

<!-- ==================== Filters ==================== -->
<section class="sticky top-16 lg:top-20 z-30 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="container mx-auto px-4 py-4">
        <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
            <!-- Search Bar -->
            <div class="w-full lg:w-96">
                <form action="/course" method="get" class="relative">
                    <i class="fas fa-search absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text"
                           name="search"
                           value="@ViewBag.CurrentSearch"
                           placeholder="جستجوی دوره..."
                           class="w-full pr-11 pl-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm">
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
                    {
                        <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
                    }
                    <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />
                </form>
            </div>

            <!-- Filter Buttons -->
            <div class="flex flex-wrap gap-2 items-center">
                <!-- Category Filter -->
                <div class="relative" x-data="{ open: false }">
                    <button @@click="open = !open"
                        class="px-4 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-xl flex items-center gap-2 text-sm font-medium transition-colors">
                        <i class="fas fa-filter text-primary-600"></i>
                        <span>@(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "دسته‌بندی" : categories.FirstOrDefault(c => c.Slug == ViewBag.CurrentCategory)?.Name ?? "دسته‌بندی")</span>
                        <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                    <div x-show="open"
                        @@click.away="open = false"
                         x-transition
                         x-cloak
                         class="absolute top-full right-0 mt-2 w-64 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 py-2 z-50 max-h-80 overflow-y-auto">
                        <a href="/course"
                           class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20 font-medium" : "text-gray-700 dark:text-gray-300")">
                            <i class="fas fa-th-large w-4"></i>
                            همه دوره‌ها
                        </a>
                        @foreach (var cat in categories)
                        {
                            <a href="?category=@cat.Slug&sort=@ViewBag.CurrentSort"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(ViewBag.CurrentCategory == cat.Slug ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20 font-medium" : "text-gray-700 dark:text-gray-300")">
                                <i class="fas fa-folder w-4"></i>
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <!-- Sort Filter -->
                <div class="relative" x-data="{ open: false }">
                    <button @@click="open = !open"
                        class="px-4 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-xl flex items-center gap-2 text-sm font-medium transition-colors">
                        <i class="fas fa-sort-amount-down text-primary-600"></i>
                        <span>مرتب‌سازی</span>
                        <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                    <div x-show="open"
                        @@click.away="open = false"
                         x-transition
                         x-cloak
                         class="absolute top-full right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 py-2 z-50">
                        @{
                            var sortOptions = new[] {
                                ("latest", "جدیدترین", "fa-clock"),
                                ("popular", "محبوب‌ترین", "fa-fire"),
                                ("rating", "بالاترین امتیاز", "fa-star"),
                                ("price_asc", "ارزان‌ترین", "fa-sort-numeric-down"),
                                ("price_desc", "گران‌ترین", "fa-sort-numeric-up")
                            };
                        }
                        @foreach (var (value, label, icon) in sortOptions)
                        {
                            <a href="?category=@ViewBag.CurrentCategory&sort=@value&search=@ViewBag.CurrentSearch"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors @(ViewBag.CurrentSort == value ? "text-primary-600 bg-primary-50 dark:bg-primary-900/20 font-medium" : "text-gray-700 dark:text-gray-300")">
                                <i class="fas @icon w-4"></i>
                                @label
                            </a>
                        }
                    </div>
                </div>

                <!-- Active Filters -->
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentCategory))
                {
                    <a href="/course"
                       class="px-4 py-2.5 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 rounded-xl flex items-center gap-2 text-sm font-medium hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors">
                        <i class="fas fa-times"></i>
                        <span>حذف فیلترها</span>
                    </a>
                }
            </div>
        </div>

        <!-- Results Count -->
        <div class="mt-3 text-sm text-gray-500 dark:text-gray-400">
            <i class="fas fa-info-circle ml-1"></i>
            @Model.TotalCount دوره یافت شد
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
            {
                <span> برای جستجوی "<span class="font-medium text-primary-600">@ViewBag.CurrentSearch</span>"</span>
            }
        </div>
    </div>
</section>

<!-- ==================== Courses Grid ==================== -->
<section class="py-12">
    <div class="container mx-auto px-4">
        @if (Model.Items.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var course in Model.Items)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="flex justify-center mt-12">
                    <nav class="flex items-center gap-2" aria-label="Pagination">
                        <!-- Previous -->
                        <a href="@GetPageUrl(Model.PageNumber - 1)"
                           class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasPreviousPage ? "" : "opacity-50 pointer-events-none")">
                            <i class="fas fa-chevron-right"></i>
                        </a>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <a href="@GetPageUrl(i)"
                                   class="min-w-[40px] h-10 flex items-center justify-center rounded-lg border @(i == Model.PageNumber ? "bg-primary-600 text-white border-primary-600" : "border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800") transition-colors">
                                    @i
                                </a>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <span class="px-2 text-gray-400">...</span>
                            }
                        }

                        <!-- Next -->
                        <a href="@GetPageUrl(Model.PageNumber + 1)"
                           class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasNextPage ? "" : "opacity-50 pointer-events-none")">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </nav>
                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-20 bg-white dark:bg-gray-800 rounded-2xl shadow-sm">
                <div class="w-24 h-24 mx-auto bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mb-4">
                    <i class="fas fa-folder-open text-4xl text-gray-400"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">هیچ دوره‌ای یافت نشد</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-6">لطفاً فیلترهای جستجو را تغییر دهید</p>
                <a href="/course" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors">
                    <i class="fas fa-redo"></i>
                    حذف فیلترها
                </a>
            </div>
        }
    </div>
</section>

@functions {
    private string GetPageUrl(int page)
    {
        var queryParams = new List<string>();
        if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
            queryParams.Add($"category={ViewBag.CurrentCategory}");
        if (!string.IsNullOrEmpty(ViewBag.CurrentSort) && ViewBag.CurrentSort != "latest")
            queryParams.Add($"sort={ViewBag.CurrentSort}");
        if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
            queryParams.Add($"search={ViewBag.CurrentSearch}");
        queryParams.Add($"page={page}");

        return $"/course?{string.Join("&", queryParams)}";
    }
}