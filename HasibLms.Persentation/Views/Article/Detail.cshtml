@model HasibLms.Shared.DTOs.ArticleDetailDto
@{
    ViewBag.Title = Model.Title;
}

<!-- Article Header -->
<section class="relative bg-gradient-to-br from-gray-900 to-gray-800 py-16">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center text-white">
            <div class="flex items-center justify-center gap-3 mb-4">
                @foreach (var tag in Model.Tags)
                {
                    <span class="px-3 py-1 bg-white/20 rounded-full text-sm">#@tag</span>
                }
            </div>
            <h1 class="text-3xl md:text-5xl font-bold mb-4">@Model.Title</h1>
            <div class="flex items-center justify-center gap-4 text-white/70">
                <div class="flex items-center gap-2">
                    <i class="fas fa-user"></i>
                    <span>@Model.AuthorName</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fas fa-calendar"></i>
                    <span>@Model.PublishedAt.ToString("yyyy/MM/dd")</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fas fa-eye"></i>
                    <span>@Model.ViewCount بازدید</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Article Content -->
<div class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content -->
        <div class="lg:w-2/3">
            <article class="bg-white dark:bg-gray-800 rounded-2xl shadow-md overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-96 object-cover">
                }
                <div class="p-6 md:p-8">
                    <div class="prose prose-lg dark:prose-invert max-w-none">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </article>
            
            <!-- Share Section -->
            <div class="mt-8 bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
                <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">اشتراک‌گذاری</h3>
                <div class="flex gap-3">
                    <button onclick="shareArticle('telegram')" class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white hover:scale-110 transition-transform">
                        <i class="fab fa-telegram"></i>
                    </button>
                    <button onclick="shareArticle('whatsapp')" class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white hover:scale-110 transition-transform">
                        <i class="fab fa-whatsapp"></i>
                    </button>
                    <button onclick="shareArticle('linkedin')" class="w-10 h-10 bg-blue-700 rounded-full flex items-center justify-center text-white hover:scale-110 transition-transform">
                        <i class="fab fa-linkedin-in"></i>
                    </button>
                    <button onclick="copyLink()" class="w-10 h-10 bg-gray-500 rounded-full flex items-center justify-center text-white hover:scale-110 transition-transform">
                        <i class="fas fa-link"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Sidebar -->
        <div class="lg:w-1/3">
            <!-- Related Articles -->
            @if (Model.RelatedArticles.Any())
            {
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-6">
                    <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">مقالات مرتبط</h3>
                    <div class="space-y-4">
                        @foreach (var article in Model.RelatedArticles)
                        {
                            <div class="flex gap-3">
                                @if (!string.IsNullOrEmpty(article.ImageUrl))
                                {
                                    <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
                                        <img src="@article.ImageUrl" alt="@article.Title" class="w-full h-full object-cover">
                                    </div>
                                }
                                <div>
                                    <a href="/article/@article.Slug" class="font-medium text-gray-800 dark:text-white hover:text-primary-600 transition-colors line-clamp-2">
                                        @article.Title
                                    </a>
                                    <div class="text-xs text-gray-500 mt-1">@article.PublishedAt.ToString("yyyy/MM/dd")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function shareArticle(platform) {
        const url = encodeURIComponent(window.location.href);
        const title = encodeURIComponent('@Model.Title');
        let shareUrl = '';
        
        switch (platform) {
            case 'telegram':
                shareUrl = `https://t.me/share/url?url=${url}&text=${title}`;
                break;
            case 'whatsapp':
                shareUrl = `https://wa.me/?text=${title}%20${url}`;
                break;
            case 'linkedin':
                shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
                break;
        }
        
        if (shareUrl) {
            window.open(shareUrl, '_blank', 'width=600,height=500');
        }
    }
    
    function copyLink() {
        navigator.clipboard.writeText(window.location.href);
        showToast('لینک مقاله کپی شد', 'success');
    }
</script>