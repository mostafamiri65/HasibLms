@using HasibLms.Shared.Extensions
@model HasibLms.Shared.DTOs.PagedResultDto<HasibLms.Shared.DTOs.ArticleCardDto>
@{
    ViewBag.Title = "مقالات آموزشی";
}

<!-- Header -->
<section class="relative bg-gradient-to-br from-primary-700 to-primary-900 py-16">
    <div class="container mx-auto px-4 text-center text-white">
        <h1 class="text-3xl md:text-5xl font-bold mb-4" data-aos="fade-up">مقالات آموزشی</h1>
        <p class="text-white/80 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            جدیدترین و تخصصی‌ترین مقالات در حوزه حسابداری، مالیات و سرمایه‌گذاری
        </p>
    </div>
</section>

<div class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content -->
        <div class="lg:w-2/3">
            @if (Model.Items.Any())
            {
                <div class="space-y-6">
                    @foreach (var article in Model.Items)
                    {
                        <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all group" data-aos="fade-up">
                            <div class="flex flex-col md:flex-row">
                                @if (!string.IsNullOrEmpty(article.ImageUrl))
                                {
                                    <div class="md:w-64 h-48 md:h-auto overflow-hidden">
                                        <img src="@article.ImageUrl"
                                             alt="@article.Title"
                                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                                    </div>
                                }
                                <div class="flex-1 p-6">
                                    <!-- Meta -->
                                    <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-3">
                                        <div class="flex items-center gap-1">
                                            <i class="fas fa-calendar"></i>
                                            <span>@article.PublishedAt.ToPersianDateFull()</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <i class="fas fa-user"></i>
                                            <span>@article.AuthorName</span>
                                        </div>
                                        @if (article.Tags.Any())
                                        {
                                            <div class="flex items-center gap-1">
                                                <i class="fas fa-tag"></i>
                                                <span>@string.Join("، ", article.Tags.Take(2))</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Title -->
                                    <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-2">
                                        <a href="/article/@article.Slug" class="hover:text-primary-600 transition-colors">
                                            @article.Title
                                        </a>
                                    </h2>

                                    <!-- Summary -->
                                    <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-2">
                                        @article.Summary
                                    </p>

                                    <!-- Read More -->
                                    <a href="/article/@article.Slug"
                                       class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-medium group-hover:gap-3 transition-all">
                                        ادامه مطلب
                                        <i class="fas fa-arrow-left text-sm"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="flex justify-center mt-8">
                        <nav class="flex items-center gap-2">
                            <a href="?page=@(Model.PageNumber - 1)"
                               class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasPreviousPage ? "" : "opacity-50 pointer-events-none")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <a href="?page=@i"
                                   class="min-w-[40px] h-10 flex items-center justify-center rounded-lg border @(i == Model.PageNumber ? "bg-primary-600 text-white border-primary-600" : "border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800") transition-colors">
                                    @i
                                </a>
                            }
                            <a href="?page=@(Model.PageNumber + 1)"
                               class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors @(Model.HasNextPage ? "" : "opacity-50 pointer-events-none")">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl">
                    <i class="fas fa-newspaper text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300">هیچ مقاله‌ای یافت نشد</h3>
                    <p class="text-gray-500 dark:text-gray-400 mt-2">به زودی مقالات جدید اضافه می‌شوند</p>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="lg:w-1/3 space-y-6">
            <!-- Search Box -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md">
                <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">جستجو در مقالات</h3>
                <form action="/article/search" method="get" class="relative">
                    <i class="fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text"
                           name="q"
                           placeholder="عنوان مقاله..."
                           class="w-full pr-10 pl-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500">
                    <button type="submit" class="hidden">جستجو</button>
                </form>
            </div>

            <!-- Popular Articles -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md">
                <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">
                    <i class="fas fa-fire text-orange-500 ml-2"></i>
                    پرطرفدارترین مقالات
                </h3>
                <div class="space-y-4">
                    @foreach (var article in ViewBag.PopularArticles ?? new List<ArticleCardDto>())
                    {
                        <div class="flex gap-3">
                            @if (!string.IsNullOrEmpty(article.ImageUrl))
                            {
                                <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0">
                                    <img src="@article.ImageUrl" alt="@article.Title" class="w-full h-full object-cover">
                                </div>
                            }
                            <div>
                                <a href="/article/@article.Slug" class="font-medium text-gray-800 dark:text-white hover:text-primary-600 transition-colors line-clamp-2">
                                    @article.Title
                                </a>
                                <div class="text-xs text-gray-500 mt-1">@article.PublishedAt.ToString("yyyy/MM/dd")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        @*     <!-- Tags -->
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md">
                <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-4">
                    <i class="fas fa-tags ml-2"></i>
                    موضوعات
                </h3>
                <div class="flex flex-wrap gap-2">
                    @foreach (var tag in ViewBag.Tags as List<TagDto> ?? new List<TagDto>())
                    {
                        <a href="/article/tag/@tag.Slug"
                           class="px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-lg text-sm hover:bg-primary-600 hover:text-white transition-colors">
                            @tag.Name
                        </a>
                    }
                </div>
            </div> *@
        </div>
    </div>
</div>