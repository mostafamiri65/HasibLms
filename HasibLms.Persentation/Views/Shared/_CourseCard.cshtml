@model HasibLms.Shared.DTOs.CourseCardDto
@using HasibLms.Domain.Interfaces
@inject ISiteService SiteService
@{
    var settings = await SiteService.GetSettingsAsync();
}

<div class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 relative" data-aos="fade-up">
    <!-- Image Container with Overlay -->
    <div class="relative overflow-hidden h-52">
        <img src="@(Model.ImageUrl ?? "/images/course-placeholder.jpg")"
             alt="@Model.Title"
             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
             loading="lazy" />
        
        <!-- Overlay Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <!-- Badges -->
        <div class="absolute top-3 right-3 flex flex-col gap-2">
            @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
            {
                <span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-lg shadow-md">
                    @Math.Round(((Model.Price - Model.DiscountPrice.Value) / Model.Price * 100))% تخفیف
                </span>
            }
            @if (Model.AverageRating >= 4.5)
            {
                <span class="bg-yellow-500 text-white text-xs font-bold px-2 py-1 rounded-lg shadow-md flex items-center gap-1">
                    <i class="fas fa-star text-xs"></i> ویژه
                </span>
            }
            @if (Model.EnrolledCount > 100)
            {
                <span class="bg-green-500 text-white text-xs font-bold px-2 py-1 rounded-lg shadow-md">
                    <i class="fas fa-fire"></i> محبوب
                </span>
            }
        </div>
        
        <!-- Price Badge -->
        <div class="absolute bottom-3 left-3 bg-black/80 backdrop-blur-sm text-white px-3 py-1.5 rounded-lg text-sm font-bold shadow-lg">
            @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
            {
                <span class="line-through text-gray-400 text-xs ml-1">@Model.Price.ToString("N0")</span>
                <span>@Model.DiscountPrice.Value.ToString("N0")</span>
            }
            else
            {
                <span>@Model.Price.ToString("N0")</span>
            }
            <span class="text-xs font-normal"> @settings?.CurrencySymbol</span>
        </div>
        
        <!-- Hover Actions -->
        <div class="absolute inset-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 bg-black/40">
            <a href="/course/@Model.Slug"
                   class="w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-primary-600 hover:text-white transition-all transform hover:scale-110">
                <i class="fas fa-eye"></i>
            </a>
            <button onclick="addToCart('@Model.Id')"
                    class="w-10 h-10 bg-white rounded-full flex items-center justify-center hover:bg-primary-600 hover:text-white transition-all transform hover:scale-110">
                <i class="fas fa-shopping-cart"></i>
            </button>
        </div>
    </div>
    
    <!-- Content -->
    <div class="p-5">
        <!-- Category & Rating -->
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/30 px-2.5 py-1 rounded-full font-medium">
                @Model.CategoryName
            </span>
            <div class="flex items-center gap-1">
                <div class="flex text-yellow-400 text-xs">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= (int)Math.Floor(Model.AverageRating))
                        {
                            <i class="fas fa-star"></i>
                        }
                        else if (i - Model.AverageRating < (double)0.6m)
                        {
                            <i class="fas fa-star-half-alt"></i>
                        }
                        else
                        {
                            <i class="far fa-star"></i>
                        }
                    }
                </div>
                <span class="text-gray-500 dark:text-gray-400 text-xs">(@Model.EnrolledCount)</span>
            </div>
        </div>
        
        <!-- Title -->
        <h3 class="font-bold text-gray-800 dark:text-white text-lg mb-2 line-clamp-2 leading-relaxed">
            <a href="/course/@Model.Slug" class="hover:text-primary-600 transition-colors">@Model.Title</a>
        </h3>
        
        <!-- Description -->
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-3 line-clamp-2 leading-relaxed">
            @Model.ShortDescription
        </p>
        
        <!-- Instructor -->
        <div class="flex items-center gap-2 mb-3">
            <div class="w-6 h-6 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center">
                <span class="text-white text-[10px] font-bold">@(Model.InstructorName?.Substring(0, 1) ?? "م")</span>
            </div>
            <span class="text-gray-600 dark:text-gray-300 text-xs">@Model.InstructorName</span>
        </div>
        
        <!-- Footer -->
        <div class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-gray-700">
            <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-xs">
                <i class="fas fa-clock"></i>
                <span>دوره آنلاین</span>
            </div>
            <a href="/course/@Model.Slug"
                   class="text-primary-600 hover:text-primary-700 text-sm font-medium flex items-center gap-1 transition-all group-hover:gap-2">
                مشاهده دوره
                <i class="fas fa-arrow-left text-xs"></i>
            </a>
        </div>
    </div>
</div>

<script>
    function addToCart(courseId) {
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        if (!cart.includes(courseId)) {
            cart.push(courseId);
            localStorage.setItem('cart', JSON.stringify(cart));
            showToast('دوره به سبد خرید اضافه شد', 'success');
            // Update cart count in header
            const cartCount = document.querySelector('.cart-count');
            if (cartCount) {
                cartCount.textContent = cart.length;
                cartCount.classList.remove('hidden');
            }
        } else {
            showToast('این دوره قبلاً در سبد خرید است', 'warning');
        }
    }
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>