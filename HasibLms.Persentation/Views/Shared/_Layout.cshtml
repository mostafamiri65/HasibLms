﻿﻿@using HasibLms.Domain.Interfaces
@using Microsoft.AspNetCore.Identity
@inject ISiteService SiteService
@inject IMenuService MenuService
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@{
    var settings = await SiteService.GetSettingsAsync();
    var isAuthenticated = SignInManager.IsSignedIn(User);
    var user = await UserManager.GetUserAsync(User);
    var headerMenu = await MenuService.GetHeaderMenuAsync(CancellationToken.None);
    var footerMenu = await MenuService.GetFooterMenuAsync(CancellationToken.None);

    var roles = isAuthenticated ? await UserManager.GetRolesAsync(user!) : new List<string>();
    var isAdmin = roles.Contains("Admin");
    var isInstructor = roles.Contains("Instructor");
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="@(settings?.PrimaryColor ?? "#3b82f6")" />

    <!-- SEO Meta Tags -->
    <meta name="description" content="@(ViewBag.MetaDescription ?? settings?.MetaDescription ?? "بزرگترین پلتفرم آموزش تخصصی حسابداری، مالیات و سرمایه‌گذاری در ایران")" />
    <meta name="keywords" content="@(ViewBag.MetaKeywords ?? settings?.MetaKeywords ?? "آموزش حسابداری, آموزش مالیات, دوره سرمایه‌گذاری, کلاس آنلاین حسابداری, مالیبا")" />
    <meta name="author" content="@(settings?.InstituteName)" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="revisit-after" content="7 days" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@(ViewBag.Title ?? settings?.InstituteName)" />
    <meta property="og:description" content="@(ViewBag.MetaDescription ?? settings?.MetaDescription)" />
    <meta property="og:image" content="@(ViewBag.OgImage ?? settings?.LogoUrl)" />
    <meta property="og:site_name" content="@(settings?.InstituteName)" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewBag.Title ?? settings?.InstituteName)" />
    <meta name="twitter:description" content="@(ViewBag.MetaDescription ?? settings?.MetaDescription)" />
    <meta name="twitter:image" content="@(ViewBag.OgImage ?? settings?.LogoUrl)" />

    <!-- Canonical URL -->
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Favicon -->
    @if (!string.IsNullOrEmpty(settings?.FaviconUrl))
    {
        <link rel="icon" type="image/x-icon" href="@settings.FaviconUrl">
        <link rel="apple-touch-icon" href="@settings.FaviconUrl">
    }

    <!-- Preconnect for CDNs -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <title>@(ViewBag.Title != null ? $"{ViewBag.Title} - {settings?.InstituteShortName}" : settings?.InstituteName)</title>

    <!-- Google Fonts - Vazirmatn for Persian -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Swiper Slider -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Sweet Alert 2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Dynamic Color Scheme -->
    <style>
        :root {
            --primary-50: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 10%, white);
            --primary-100: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 20%, white);
            --primary-200: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 40%, white);
            --primary-300: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 60%, white);
            --primary-400: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 80%, white);
            --primary-500: @(settings?.PrimaryColor ?? "#3b82f6");
            --primary-600: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 80%, black);
            --primary-700: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 60%, black);
            --primary-800: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 40%, black);
            --primary-900: color-mix(in srgb, @(settings?.PrimaryColor ?? "#3b82f6") 20%, black);
            --secondary-500: @(settings?.SecondaryColor ?? "#10b981");
        }

        /* Custom color classes using CSS variables */
        .bg-primary {
            background-color: var(--primary-500);
        }

        .bg-primary-dark {
            background-color: var(--primary-700);
        }

        .text-primary {
            color: var(--primary-500);
        }

        .border-primary {
            border-color: var(--primary-500);
        }

        .hover\:bg-primary:hover {
            background-color: var(--primary-600);
        }

        .hover\:text-primary:hover {
            color: var(--primary-500);
        }

        /* Override Tailwind colors */
        .bg-primary-600 {
            background-color: var(--primary-600);
        }

        .bg-primary-700 {
            background-color: var(--primary-700);
        }

        .text-primary-600 {
            color: var(--primary-600);
        }

        .hover\:bg-primary-700:hover {
            background-color: var(--primary-700);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 font-sans antialiased"
      x-data="{
          mobileMenuOpen: false,
          darkMode: localStorage.getItem('darkMode') === 'true',
          searchOpen: false,
          userMenuOpen: false,
          cartOpen: false,
          showBackToTop: false
      }"
      x-init="() =>
    {
    if(darkMode) document.documentElement.classList.add('dark');

    setTimeout(() => {
    if (typeof AOS !== 'undefined') {
    AOS.init({ duration: 800, once: true });
    }
    }, 100);

    window.addEventListener('scroll', () => {
    showBackToTop = window.scrollY > 300;
    });

    cartCount = JSON.parse(localStorage.getItem('cart') || '[]').length;
    }"
    :class="{ 'dark': darkMode }">

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="fixed inset-0 bg-white dark:bg-gray-900 z-[100] flex items-center justify-center transition-opacity duration-300" x-show="false" x-cloak>
        <div class="text-center">
            <div class="w-16 h-16 border-4 border-primary-200 border-t-primary-600 rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-gray-600 dark:text-gray-300">در حال بارگذاری...</p>
        </div>
    </div>

    <!-- ===== HEADER ===== -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-all duration-300">
        <nav class="container mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2 shrink-0">
                    @if (!string.IsNullOrEmpty(settings?.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="@settings.InstituteName" class="h-10 w-auto" />
                    }
                    else
                    {
                        <span class="text-2xl font-bold text-primary-600">@(settings?.InstituteShortName ?? "مالیبا")</span>
                    }
                </a>

                <!-- Desktop Menu -->
                <ul class="hidden lg:flex items-center gap-1">
                    @if (headerMenu != null && headerMenu.Any())
                    {
                        foreach (var item in headerMenu)
                        {
                            if (item.Children != null && item.Children.Any())
                            {
                                <li class="relative group">
                                    <button class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 dark:hover:text-primary-400 transition-all flex items-center gap-1">
                                        @if (!string.IsNullOrEmpty(item.Icon))
                                        {
                                            <i class="@item.Icon text-sm"></i>
                                        }
                                        @item.Title
                                        <i class="fas fa-chevron-down text-xs"></i>
                                    </button>
                                    <div class="absolute right-0 mt-1 w-56 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                                        @foreach (var child in item.Children)
                                        {
                                            <a href="@(child.Url ?? "#")" target="@(item.Target ?? "_self")" class="block px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-primary-600 dark:hover:text-primary-400 transition-all">
                                                @if (!string.IsNullOrEmpty(child.Icon))
                                                {
                                                    <i class="@child.Icon ml-2 w-4 text-center"></i>
                                                }
                                                @child.Title
                                            </a>
                                        }
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a href="@(item.Url ?? "#")" target="@(item.Target ?? "_self")" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 dark:hover:text-primary-400 transition-all flex items-center gap-1">
                                        @if (!string.IsNullOrEmpty(item.Icon))
                                        {
                                            <i class="@item.Icon text-sm"></i>
                                        }
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }
                    }
                    else
                    {
                        <!-- منوهای پیش‌فرض در صورت خالی بودن -->
                        <li><a href="/" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 transition-all">خانه</a></li>
                        <li><a href="/course" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 transition-all">دوره‌ها</a></li>
                        <li><a href="/article" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 transition-all">مقالات</a></li>
                        <li><a href="/home/about" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 transition-all">درباره ما</a></li>
                        <li><a href="/home/contact" class="px-4 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary-600 transition-all">تماس با ما</a></li>
                    }
                </ul>

                <!-- Right Side Actions -->
                <div class="flex items-center gap-2">
                    <!-- Dark Mode Toggle -->
                    <button @@click="darkMode = !darkMode; localStorage.setItem('darkMode', darkMode); document.documentElement.classList.toggle('dark')"
                            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400 transition-all">
                        <i class="fas" :class="darkMode ? 'fa-sun' : 'fa-moon'"></i>
                    </button>

                    <!-- Search -->
                    <button @@click="searchOpen = !searchOpen" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400 transition-all">
                        <i class="fas fa-search"></i>
                    </button>

                    <!-- User Menu -->
                    @if (isAuthenticated && user != null)
                    {
                        <div class="relative" x-data="{ open: false }">
                            <button @@click="open = !open" class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" alt="@user.FullName" class="w-8 h-8 rounded-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-sm">
                                        @(user.FullName?.FirstOrDefault().ToString() ?? "U")
                                    </div>
                                }
                            </button>
                            <div x-show="open"
                                 @@click.away="open = false"
                                 class="absolute left-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 py-1">
                                <div class="px-4 py-3 border-b border-gray-100 dark:border-gray-700">
                                    <p class="font-medium text-gray-800 dark:text-white">@user.FullName</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">@user.Email</p>
                                </div>
                                <a href="/auth/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                                    <i class="fas fa-user w-4 text-center"></i>پروفایل
                                </a>
                                 @if (isAdmin)
                {
                    <a href="/admin" class="px-3 py-2.5 rounded-xl hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors text-primary-600 dark:text-primary-400">
                        <i class="fas fa-chart-line ml-2"></i> پنل مدیریت
                    </a>
                }
                @if (isInstructor && !isAdmin)
                {
                    <a href="/instructor/dashboard" class="px-3 py-2.5 rounded-xl hover:bg-secondary-50 dark:hover:bg-secondary-900/20 transition-colors text-secondary-500">
                        <i class="fas fa-chalkboard-teacher ml-2"></i> پنل مدرس
                    </a>
                }
                                @* @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                                {
                                    <a href="/instructor/dashboard" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                                        <i class="fas fa-chalkboard-teacher w-4 text-center"></i>داشبورد مدرس
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="/admin" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
                                        <i class="fas fa-cog w-4 text-center"></i>پنل مدیریت
                                    </a>
                                } *@
                                <form method="post" action="/auth/logout" class="block">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 w-full text-right transition-all">
                                        <i class="fas fa-sign-out-alt w-4 text-center"></i>خروج
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/auth/login" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-all text-sm font-medium">
                            ورود / ثبت نام
                        </a>
                    }

                    <!-- Mobile Menu Toggle -->
                    <button @@click="mobileMenuOpen = !mobileMenuOpen" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400 transition-all">
                        <i class="fas" :class="mobileMenuOpen ? 'fa-times' : 'fa-bars'"></i>
                    </button>
                </div>
            </div>

            <!-- Search Bar -->
            <div x-show="searchOpen"
                 x-transition
                 class="mt-3">
                <form action="/course/search" method="get" class="relative">
                    <input type="text"
                           name="q"
                           placeholder="جستجوی دوره، مقاله، مدرس..."
                           class="w-full px-4 py-3 pr-12 bg-gray-100 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 focus:border-primary-500 dark:focus:border-primary-500 outline-none transition-all text-gray-800 dark:text-white" />
                    <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary-600 transition-all">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
            </div>

            <!-- Mobile Menu -->
            <div x-show="mobileMenuOpen"
                 x-transition
                 class="lg:hidden mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                <ul class="space-y-1">
                    @if (headerMenu != null && headerMenu.Any())
                    {
                        foreach (var item in headerMenu)
                        {
                            if (item.Children != null && item.Children.Any())
                            {
                                <li x-data="{ open: false }">
                                    <button @@click="open = !open" class="flex items-center justify-between w-full px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
                                        <span class="flex items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.Icon))
                                            {
                                                <i class="@item.Icon"></i>
                                            }
                                            @item.Title
                                        </span>
                                        <i class="fas fa-chevron-down text-xs transition-transform" :class="open ? 'rotate-180' : ''"></i>
                                    </button>
                                    <div x-show="open" class="mr-4 space-y-1">
                                        @foreach (var child in item.Children)
                                        {
                                            <a href="@(child.Url ?? "#")" target="@(item.Target ?? "_self")" class="block px-4 py-2.5 rounded-lg text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-primary-600 dark:hover:text-primary-400 transition-all">
                                                @if (!string.IsNullOrEmpty(child.Icon))
                                                {
                                                    <i class="@child.Icon ml-2"></i>
                                                }
                                                @child.Title
                                            </a>
                                        }
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a href="@(item.Url ?? "#")" target="@(item.Target ?? "_self")" class="flex items-center gap-2 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
                                        @if (!string.IsNullOrEmpty(item.Icon))
                                        {
                                            <i class="@item.Icon"></i>
                                        }
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }
                    }
                    else
                    {
                        <li><a href="/" class="block px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">خانه</a></li>
                        <li><a href="/course" class="block px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">دوره‌ها</a></li>
                        <li><a href="/article" class="block px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">مقالات</a></li>
                        <li><a href="/home/about" class="block px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">درباره ما</a></li>
                        <li><a href="/home/contact" class="block px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">تماس با ما</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-4 left-4 z-50 space-y-2"></div>

    <main class="min-h-screen pt-20">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="bg-gray-900 text-gray-300">
        <div class="container mx-auto px-4 py-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- About -->
                <div>
                    <h3 class="text-white font-bold text-lg mb-4">@(settings?.InstituteName ?? "مالیبا")</h3>
                    <p class="text-sm leading-relaxed text-gray-400">
                        @(settings?.AboutText ?? "موسسه آموزشی تخصصی حسابداری و مالی با بیش از ۱۰ سال تجربه")
                    </p>
                    <div class="mt-4 flex gap-3">
                        @if (!string.IsNullOrEmpty(settings?.Instagram))
                        {
                            <a href="@settings.Instagram" target="_blank" class="text-gray-400 hover:text-white transition-all"><i class="fab fa-instagram text-xl"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings?.Telegram))
                        {
                            <a href="@settings.Telegram" target="_blank" class="text-gray-400 hover:text-white transition-all"><i class="fab fa-telegram text-xl"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings?.LinkedIn))
                        {
                            <a href="@settings.LinkedIn" target="_blank" class="text-gray-400 hover:text-white transition-all"><i class="fab fa-linkedin text-xl"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings?.YouTube))
                        {
                            <a href="@settings.YouTube" target="_blank" class="text-gray-400 hover:text-white transition-all"><i class="fab fa-youtube text-xl"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings?.WhatsApp))
                        {
                            <a href="@settings.WhatsApp" target="_blank" class="text-gray-400 hover:text-white transition-all"><i class="fab fa-whatsapp text-xl"></i></a>
                        }
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">لینک‌های سریع</h4>
                    <ul class="space-y-2">
                        @if (footerMenu != null && footerMenu.Any())
                        {
                            foreach (var item in footerMenu)
                            {
                                <li>
                                    <a href="@(item.Url ?? "#")" target="@(item.Target ?? "_self")" class="text-gray-400 hover:text-white transition-all text-sm">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li><a href="/home/about" class="text-gray-400 hover:text-white transition-all text-sm">درباره ما</a></li>
                            <li><a href="/home/contact" class="text-gray-400 hover:text-white transition-all text-sm">تماس با ما</a></li>
                            <li><a href="/home/privacy" class="text-gray-400 hover:text-white transition-all text-sm">حریم خصوصی</a></li>
                            <li><a href="/home/terms" class="text-gray-400 hover:text-white transition-all text-sm">قوانین و مقررات</a></li>
                        }
                    </ul>
                </div>

                <!-- Contact Info -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">اطلاعات تماس</h4>
                    <ul class="space-y-3 text-sm">
                        @if (!string.IsNullOrEmpty(settings?.Address))
                        {
                            <li class="flex items-start gap-3">
                                <i class="fas fa-map-marker-alt text-primary-500 mt-1"></i>
                                <span class="text-gray-400">@settings.Address</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(settings?.Phone))
                        {
                            <li class="flex items-center gap-3">
                                <i class="fas fa-phone text-primary-500"></i>
                                <span class="text-gray-400">@settings.Phone</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(settings?.Email))
                        {
                            <li class="flex items-center gap-3">
                                <i class="fas fa-envelope text-primary-500"></i>
                                <span class="text-gray-400">@settings.Email</span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Newsletter -->
                <div>
                    <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">خبرنامه</h4>
                    <p class="text-sm text-gray-400 mb-3">با عضویت در خبرنامه، از جدیدترین دوره‌ها مطلع شوید</p>
                    <form id="newsletterForm" class="flex flex-col gap-2">
                        <input type="email" id="newsletterEmail" placeholder="ایمیل خود را وارد کنید" class="px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-lg focus:border-primary-500 outline-none text-white text-sm" required />
                        <button type="submit" class="px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-all text-sm font-medium">
                            عضویت
                        </button>
                    </form>
                </div>
            </div>

            <!-- Copyright -->
            <div class="mt-8 pt-6 border-t border-gray-800 text-center text-sm text-gray-500">
                @(settings?.CopyrightText ?? "تمامی حقوق برای موسسه آموزشی مالیبا محفوظ است.")
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <button x-show="showBackToTop"
            x-transition
            @@click="window.scrollTo({top: 0, behavior: 'smooth'})"
            class="fixed bottom-8 left-8 bg-primary-600 text-white p-3 rounded-full shadow-lg hover:bg-primary-700 transition-all duration-300 hover:scale-110 z-40 group">
        <i class="fas fa-arrow-up group-hover:-translate-y-1 transition-transform"></i>
    </button>

    <!-- Cookie Consent -->
    <div x-data="{ showCookie: localStorage.getItem('cookieConsent') !== 'true' }"
         x-show="showCookie"
         x-transition
         class="fixed bottom-4 right-4 left-4 md:right-auto md:left-auto md:max-w-md bg-gray-900 text-white rounded-xl shadow-2xl p-4 z-50">
        <div class="flex items-start gap-3">
            <i class="fas fa-cookie-bite text-2xl text-primary-400"></i>
            <div class="flex-1">
                <p class="text-sm leading-relaxed">
                    ما از کوکی‌ها برای بهبود تجربه شما استفاده می‌کنیم. با ادامه استفاده از سایت، با
                    <a href="/privacy" class="text-primary-400 hover:underline">سیاست حریم خصوصی</a> موافقت می‌کنید.
                </p>
            </div>
            <button @@click="localStorage.setItem('cookieConsent', 'true'); showCookie = false"
                    class="px-3 py-1 bg-primary-600 hover:bg-primary-700 rounded-lg text-sm transition-colors">
                قبول
            </button>
        </div>
    </div>

    <!-- ====== اسکریپت‌ها ====== -->
