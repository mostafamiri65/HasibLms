                                    400: 'var(--primary-400)',
                                    500: 'var(--primary-500)',
                                    600: 'var(--primary-600)',
                                    700: 'var(--primary-700)',
                                    800: 'var(--primary-800)',
                                    900: 'var(--primary-900)',
                                },
                                secondary: {
